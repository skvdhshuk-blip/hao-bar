    "Run a script every few seconds. Exit 0 shows icons; any other exit code hides them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a script every few seconds. Exit 0 shows icons; any other exit code hides them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔几秒运行一次脚本。退出码 0 显示图标，其他则隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔幾秒執行一次腳本。結束代碼 0 顯示圖示，其他則隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数秒ごとにスクリプトを実行。終了0で表示、それ以外は隠す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 초마다 스크립트를 실행합니다. 종료 코드 0이면 표시, 그 외는 가립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle paar Sekunden ein Skript. Exit 0 zeigt Symbole, jeder andere Code blendet sie aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute un script toutes les quelques secondes. Sortie 0 affiche, tout autre code masque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un script cada pocos segundos. Salida 0 muestra; cualquier otro oculta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa um script a cada poucos segundos. Saída 0 mostra; qualquer outro oculta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue uno script ogni pochi secondi. Uscita 0 mostra; qualsiasi altro nasconde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voert elke paar seconden een script uit. Exit 0 toont; elke andere code verbergt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy script vài giây một lần. Thoát 0 thì hiện; mã khác thì ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รันสคริปต์ทุกไม่กี่วินาที รหัสออก 0 แสดง ค่าอื่นซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan skrip setiap beberapa detik. Keluar 0 menampilkan; kode lain menyembunyikan."
          }
        }
      }
    },
    "Run Arrange Now after Accessibility is granted, then save a restore point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Arrange Now after Accessibility is granted, then save a restore point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予辅助功能后运行「立即整理」，再保存一个还原点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授予輔助使用後執行「立即整理」，再儲存一個還原點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ許可のあと「今すぐ整列」を実行し、復元ポイントを保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용을 허용한 뒤 ‘지금 정렬’을 실행하고 복원 지점을 저장하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe nach erteilten Bedienungshilfen „Jetzt anordnen“ aus und speichere einen Wiederherstellungspunkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après Accessibilité, lancez Organiser maintenant, puis enregistrez un point de restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras conceder Accesibilidad, ejecuta Organizar ahora y guarda un punto de restauración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da Acessibilidade, execute Organizar agora e salve um ponto de restauração."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo Accessibilità, esegui Disponi ora e salva un punto di ripristino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer na Toegankelijkheid Nu ordenen uit en bewaar een herstelpunt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi có Trợ năng, chạy Sắp xếp ngay rồi lưu điểm khôi phục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อได้อนุญาตการเข้าถึงแล้ว ให้รันจัดเรียงทันที แล้วบันทึกจุดคืนค่า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah Aksesibilitas diberikan, jalankan Atur sekarang, lalu simpan titik pemulihan."
          }
        }
      }
    },
