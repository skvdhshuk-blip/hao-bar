    "1. Click any icon here to open it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Click any icon here to open it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 点击这里的任意图标即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 點一下這裡的任一圖示即可打開。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ここのアイコンをクリックして開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 여기 아이콘을 클릭하면 열립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Klicke hier auf ein Symbol, um es zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Cliquez sur une icône ici pour l’ouvrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Haz clic en cualquier icono para abrirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Clique em qualquer ícone aqui para abri-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Fai clic su un’icona qui per aprirla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Klik hier op een pictogram om het te openen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Bấm biểu tượng ở đây để mở."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1. คลิกไอคอนที่นี่เพื่อเปิด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Klik ikon di sini untuk membukanya."
          }
        }
      }
    },
    "1. Use the tabs to browse each row.": {
