    "Copies a support report with current permissions, layout state, item counts, and recent diagnostics to the clipboard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies a support report with current permissions, layout state, item counts, and recent diagnostics to the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把包含当前权限、布局状态、项目数量和近期诊断的支持报告复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把包含目前權限、佈局狀態、項目數量和近期診斷的支援報告複製到剪貼板。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限、レイアウト状態、項目数、直近の診断を含むサポートレポートをクリップボードにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 권한, 레이아웃 상태, 항목 수, 최근 진단을 담은 지원 보고서를 클립보드에 복사합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert einen Supportbericht mit Berechtigungen, Layoutstatus, Objektzahlen und aktuellen Diagnosen in die Zwischenablage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie un rapport d’assistance (autorisations, état de la disposition, comptes, diagnostics récents) dans le presse-papiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia al portapapeles un informe con permisos, estado de la disposición, recuentos y diagnósticos recientes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia para a área de transferência um relatório com permissões, estado do layout, contagens e diagnósticos recentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia negli appunti un report con autorizzazioni, stato del layout, conteggi e diagnostica recente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
