    "Open the Icon Panel window with search and icon clicking. Pro adds moving icons and Always Hidden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Icon Panel window with search and icon clicking. Pro adds moving icons and Always Hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开带搜索和点击的图标面板。Pro 可移动图标并使用始终隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開帶搜尋和點按的圖示面板。Pro 可移動圖示並使用一律隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索とクリック付きパネルを開く。Proは移動と常に非表示も。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색과 클릭이 있는 패널을 엽니다. Pro는 이동과 항상 숨김까지."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Symbolpanel mit Suche und Klicks. Pro: Verschieben und Immer ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le panneau avec recherche et clics. Pro ajoute le déplacement et Toujours masqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el panel con búsqueda y clics. Pro añade mover iconos y Siempre oculto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o painel com pesquisa e cliques. O Pro adiciona mover ícones e Sempre oculto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il pannello con ricerca e clic. Pro aggiunge lo spostamento e Sempre nascosto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent het paneel met zoeken en klikken. Pro: verplaatsen en Altijd verborgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bảng có tìm và bấm. Pro thêm chuyển icon và Luôn ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแผงไอคอนพร้อมค้นหาและคลิก Pro เพิ่มการย้ายกับซ่อนตลอด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka panel dengan pencarian dan klik. Pro menambah pemindahan ikon dan Selalu tersembunyi."
          }
        }
      }
    },
    "Open with ⌘⇧Space, then browse icons in either layout.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open with ⌘⇧Space, then browse icons in either layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ⌘⇧Space 打开，然后在任一布局里浏览图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ⌘⇧Space 打開，然後在任一佈局裡瀏覽圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⇧Spaceで開いて、どちらのレイアウトでもアイコンを見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘⇧Space로 연 뒤, 어느 레이아웃에서든 아이콘을 둘러보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne mit ⌘⇧Leertaste und durchsuche Symbole in beiden Layouts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez avec ⌘⇧Espace, puis parcourez les icônes dans l’une ou l’autre disposition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo con ⌘⇧Espacio y explora iconos en cualquiera de los dos diseños."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra com ⌘⇧Espaço e explore ícones em qualquer um dos layouts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri con ⌘⇧Spazio e sfoglia le icone in entrambi i layout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open met ⌘⇧Spatie en bekijk pictogrammen in beide lay-outs."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bằng ⌘⇧Space, rồi duyệt biểu tượng ở bố cục nào cũng được."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดด้วย ⌘⇧Space แล้วเรียกดูไอคอนได้ทั้งสองเลย์เอาต์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dengan ⌘⇧Space, lalu jelajahi ikon di salah satu tata letak."
          }
        }
      }
    },
    "Opens Accessibility settings so you can grant HaoBar permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Accessibility settings so you can grant HaoBar permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开辅助功能设置，以便授予 HaoBar 权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
