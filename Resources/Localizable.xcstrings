            "state": "translated",
            "value": "HaoBar có thể xem và sắp xếp mục trên thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ตรวจและจัดเรียงรายการแถบเมนูได้"
          }
        },
        "id": {
