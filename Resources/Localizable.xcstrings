    "Thank you for helping make SaneApps possible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for helping make SaneApps possible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢你让 SaneApps 成为可能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "謝謝你讓 SaneApps 成為可能。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SaneAppsを支えてくれてありがとう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SaneApps가 가능하게 도와주셔서 감사합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du SaneApps möglich machst."
          }
        },
        "fr": {
