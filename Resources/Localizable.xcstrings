        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar peut importer vos réglages Ice ici, mais Ice n’enregistre pas les positions des icônes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar puede importar tus ajustes de Ice, pero Ice no guarda las posiciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar pode importar seus ajustes do Ice, mas o Ice não guarda posições dos ícones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar può importare le impostazioni di Ice, ma Ice non memorizza le posizioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kan je Ice-instellingen hier importeren, maar Ice bewaart geen pictogramposities."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar có thể nhập cài đặt Ice tại đây, nhưng Ice không lưu vị trí biểu tượng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar นำเข้าการตั้งค่า Ice ได้ที่นี่ แต่ Ice ไม่เก็บตำแหน่งไอคอน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar dapat mengimpor pengaturan Ice di sini, tetapi Ice tidak menyimpan posisi ikon."
          }
        }
      }
    },
    "HaoBar can inspect and arrange menu bar items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar can inspect and arrange menu bar items."
          }
        },
        "zh-Hans": {
