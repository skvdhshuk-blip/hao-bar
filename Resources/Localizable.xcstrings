        }
      }
    },
    "Reveal selected icons when your Mac joins specific Wi-Fi networks": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal selected icons when your Mac joins specific Wi-Fi networks"
