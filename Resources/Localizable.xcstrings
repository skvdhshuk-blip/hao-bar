            "value": "Los gestos revelan los iconos ocultos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gestos revelam os ícones ocultos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gesti mostrano le icone nascoste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaren tonen verborgen pictogrammen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử chỉ sẽ hiện biểu tượng đang ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ท่าทางจะเปิดไอคอนที่ซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestur menampilkan ikon tersembunyi."
          }
        }
      }
    },
    "Gestures toggle visibility. Scroll up shows icons, scroll down hides them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestures toggle visibility. Scroll up shows icons, scroll down hides them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势切换显示。向上滚动显示图标，向下滚动隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手勢切換顯示。向上捲動顯示圖示，向下捲動隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャで表示を切り替え。上スクロールで表示、下スクロールで隠す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처로 표시를 전환합니다. 위로 스크롤하면 보이고, 아래로 스크롤하면 가려집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesten schalten die Sichtbarkeit. Nach oben scrollen zeigt Symbole, nach unten blendet sie aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes basculent l’affichage. Défiler vers le haut affiche, vers le bas masque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gestos alternan la visibilidad. Desliza arriba para mostrar, abajo para ocultar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gestos alternam a visibilidade. Role para cima para mostrar, para baixo para ocultar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gesti commutano la visibilità. Scorri su per mostrare, giù per nascondere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaren schakelen de zichtbaarheid. Omhoog scrollen toont, omlaag verbergt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử chỉ bật/tắt. Cuộn lên thì hiện, cuộn xuống thì ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ท่าทางสลับการแสดง เลื่อนขึ้นเพื่อแสดง เลื่อนลงเพื่อซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestur mengganti visibilitas. Gulir naik menampilkan, gulir turun menyembunyikan."
          }
        }
      }
    },
