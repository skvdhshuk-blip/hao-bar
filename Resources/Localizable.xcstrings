            "value": "Pembaruan perangkat lunak"
          }
        }
      }
    },
    "Some expected menu bar items are not currently visible to HaoBar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some expected menu bar items are not currently visible to HaoBar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些预期的菜单栏项目 HaoBar 目前看不见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些預期的選單列項目 HaoBar 目前看不見。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想定しているメニューバー項目の一部が、今HaoBarから見えていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "있어야 할 메뉴 막대 항목 중 일부가 지금 HaoBar에 보이지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige erwartete Menüleistenobjekte sind für HaoBar gerade nicht sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments attendus ne sont pas visibles pour HaoBar en ce moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos elementos esperados no son visibles ahora para HaoBar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns itens esperados não estão visíveis agora para o HaoBar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni elementi attesi non sono al momento visibili a HaoBar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige verwachte menubalkitems zijn nu niet zichtbaar voor HaoBar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số mục thanh menu đáng lẽ có, HaoBar hiện không thấy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการแถบเมนูที่คาดไว้บางรายการ HaoBar มองไม่เห็นตอนนี้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa item bilah menu yang diharapkan saat ini tidak terlihat oleh HaoBar."
          }
        }
      }
    },
    "Some menu bar windows are detached from their expected anchors. Arrange Now can repair this.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some menu bar windows are detached from their expected anchors. Arrange Now can repair this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些菜单栏窗口已脱离预期锚点。「立即整理」可以修好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些選單列視窗已脫離預期錨點。「立即整理」可以修好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のメニューバーウィンドウが想定アンカーから離れています。「今すぐ整列」で修復できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 메뉴 막대 윈도우가 예상 앵커에서 떨어져 있습니다. ‘지금 정렬’로 고칠 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Menüleistenfenster sind von ihren Ankern gelöst. „Jetzt anordnen“ kann das reparieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines fenêtres sont détachées de leurs ancrages. Organiser maintenant peut réparer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas ventanas están separadas de sus anclas. Organizar ahora puede repararlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas janelas estão desanexadas das âncoras. Organizar agora pode reparar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune finestre sono scollegate dalle ancore. Disponi ora può ripararlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige vensters zijn los van hun ankers. Nu ordenen kan dit herstellen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số cửa sổ thanh menu đã tách khỏi mốc neo. Sắp xếp ngay có thể sửa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างแถบเมนูบางอันหลุดจากจุดยึด จัดเรียงทันทีซ่อมได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa jendela bilah menu terlepas dari jangkar. Atur sekarang dapat memperbaikinya."
          }
        }
      }
    },
    "Some Visible icons may still get squeezed off-screen. Second Menu Bar works better for crowded setups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some Visible icons may still get squeezed off-screen. Second Menu Bar works better for crowded setups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些可见图标仍可能被挤出屏幕。图标很多时，第二菜单栏更合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些可見圖示仍可能被擠出螢幕。圖示很多時，第二選單列更合適。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のアイコンが画面外に押し出されることもあります。混雑しているならセカンドメニューバーの方が向いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 아이콘이 화면 밖으로 밀릴 수도 있습니다. 빽빽하면 두 번째 메뉴 막대가 더 낫습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche sichtbaren Symbole können trotzdem aus dem Bild gedrückt werden. Bei Gedränge ist die zweite Menüleiste besser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines icônes visibles peuvent encore être poussées hors écran. La seconde barre convient mieux aux barres bondées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos iconos visibles aún pueden salirse de la pantalla. La segunda barra va mejor si hay apreturas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns ícones visíveis ainda podem ser empurrados para fora. A segunda barra funciona melhor quando está lotado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune icone visibili possono comunque uscire dallo schermo. La seconda barra sta meglio se è pieno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige zichtbare pictogrammen kunnen nog van het scherm gedrukt worden. De tweede menubalk is beter bij gedrang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số icon Hiện vẫn có thể bị đẩy khỏi màn. Thanh menu thứ hai hợp hơn khi chật."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนที่แสดงบางตัวอาจยังถูกเบียดออกจอ แถบเมนูที่สองเหมาะกว่าตอนแน่น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa ikon Terlihat masih bisa terdorong keluar layar. Bilah menu kedua lebih pas jika penuh."
          }
        }
      }
    },
