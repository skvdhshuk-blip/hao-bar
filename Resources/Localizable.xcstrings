    "Add extra visual dividers to organize your menu bar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add extra visual dividers to organize your menu bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加额外的视觉分隔，方便整理菜单栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入額外的視覺分隔，方便整理選單列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加の視覚的な区切りでメニューバーを整理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시각적 구분선을 더해 메뉴 막대를 정리합니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche visuelle Trenner zum Ordnen der Menüleiste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des séparateurs visuels pour organiser la barre des menus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir divisores visuales extra para organizar la barra de menús"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar divisores visuais extras para organizar a barra de menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi divisori visivi extra per organizzare la barra dei menu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra visuele scheidingen om de menubalk te ordenen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm đường chia để sắp xếp thanh menu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเส้นแบ่งภาพเพื่อจัดแถบเมนู"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan pemisah visual ekstra untuk merapikan bilah menu"
          }
        }
      }
    },
    "Add small line or dot menu bar items. Command-drag them into place; they do not create extra hidden sections.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add small line or dot menu bar items. Command-drag them into place; they do not create extra hidden sections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加细线或圆点菜单栏项。按住 ⌘ 拖到位置；它们不会多出隐藏分区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入細線或圓點選單列項目。按住 ⌘ 拖到位置；不會多出隱藏區段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細い線やドットのメニューバー項目を追加。⌘を押しながら配置します。追加の非表示セクションは作りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가는 선이나 점 메뉴 막대 항목을 추가합니다. ⌘을 누른 채 드래그해 놓으세요. 숨겨진 구역이 더 생기지는 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Linien- oder Punkt-Menüleistenobjekte. Mit ⌘ an die gewünschte Stelle ziehen; sie erzeugen keine extra ausgeblendeten Abschnitte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez de petites lignes ou points. Faites-les glisser avec ⌘ ; elles ne créent pas de sections masquées supplémentaires."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade líneas o puntos. Arrástralos con ⌘; no crean secciones ocultas extra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione linhas ou pontos. Arraste-os com ⌘; eles não criam seções ocultas extras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi linee o punti. Trascinali con ⌘; non creano sezioni nascoste extra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg dunne lijn- of puntitems toe. Sleep ze met ⌘ op hun plek; ze maken geen extra verborgen secties."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm gạch hoặc chấm nhỏ trên thanh menu. Giữ ⌘ rồi kéo vào chỗ; chúng không tạo thêm vùng ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเส้นหรือจุดเล็กบนแถบเมนู กด ⌘ ค้างแล้วลากไปวาง จะไม่สร้างโซนซ่อนเพิ่ม"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan garis atau titik kecil. Seret dengan ⌘ ke tempatnya; tidak membuat bagian tersembunyi ekstra."
          }
        }
      }
    },
    "Add subtle shadow below the menu bar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add subtle shadow below the menu bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏下方加一点淡阴影"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列下方加一點淡陰影"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの下に控えめな影を付ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아래에 은은한 그림자를 넣습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen dezenten Schatten unter die Menüleiste legen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une ombre légère sous la barre des menus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una sombra sutil bajo la barra de menús"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma sombra sutil abaixo da barra de menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un’ombra lieve sotto la barra dei menu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een subtiele schaduw onder de menubalk zetten"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bóng nhẹ dưới thanh menu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่เงาบางๆ ใต้แถบเมนู"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan bayangan halus di bawah bilah menu"
          }
        }
      }
    },
    "Adds small line/dot menu bar items. Command-drag them into place. They do not create extra hidden sections or menu-bar layers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds small line/dot menu bar items. Command-drag them into place. They do not create extra hidden sections or menu-bar layers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加细线/圆点菜单栏项。按住 ⌘ 拖到位置。不会多出隐藏分区或菜单栏图层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入細線／圓點選單列項目。按住 ⌘ 拖到位置。不會多出隱藏區段或選單列圖層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細い線/ドットの項目を追加。⌘ドラッグで配置。追加の非表示セクションやメニューバー層は作りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가는 선/점 항목을 추가합니다. ⌘ 드래그로 놓으세요. 숨겨진 구역이나 메뉴 막대 레이어가 더 생기지는 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt kleine Linien-/Punkt-Objekte hinzu. Mit ⌘ platzieren. Keine extra ausgeblendeten Abschnitte oder Menüleisten-Ebenen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute de petites lignes/points. Placez-les avec ⌘. Pas de sections masquées ni de couches de barre des menus en plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade líneas/puntos. Colócalos con ⌘. No crea secciones ocultas ni capas extra de la barra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona linhas/pontos. Posicione com ⌘. Não cria seções ocultas nem camadas extras da barra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge linee/punti. Posizionali con ⌘. Non crea sezioni nascoste né livelli extra della barra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt lijn-/puntitems toe. Plaats ze met ⌘. Geen extra verborgen secties of menubalklagen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm gạch/chấm nhỏ. Giữ ⌘ rồi kéo vào chỗ. Không tạo thêm vùng ẩn hay lớp thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเส้น/จุดเล็ก กด ⌘ ค้างแล้วลากไปวาง จะไม่สร้างโซนซ่อนหรือชั้นแถบเมนูเพิ่ม"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menambah garis/titik kecil. Seret dengan ⌘. Tidak membuat bagian tersembunyi atau lapisan bilah menu ekstra."
          }
        }
      }
    },
