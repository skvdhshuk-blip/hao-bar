    "Finish setup with a permission check and a saved layout restore point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish setup with a permission check and a saved layout restore point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做一次权限检查并保存布局还原点，即可完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
