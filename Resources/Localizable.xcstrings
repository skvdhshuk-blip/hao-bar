    "HaoBar is protecting the layout while macOS is temporarily hiding or moving menu bar items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar is protecting the layout while macOS is temporarily hiding or moving menu bar items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 暂时隐藏或移动菜单栏项目时，HaoBar 正在保护布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 暫時隱藏或移動選單列項目時，HaoBar 正在保護佈局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSが一時的に項目を隠したり動かしたりしているあいだ、レイアウトを保護しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 메뉴 막대 항목을 잠시 가리거나 옮기는 동안 HaoBar가 레이아웃을 보호합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar schützt das Layout, während macOS Objekte vorübergehend ausblendet oder verschiebt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar protège la disposition pendant que macOS masque ou déplace temporairement des éléments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar protege la disposición mientras macOS oculta o mueve elementos temporalmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar protege o layout enquanto o macOS oculta ou move itens temporariamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar protegge il layout mentre macOS nasconde o sposta temporaneamente elementi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar beschermt de layout terwijl macOS items tijdelijk verbergt of verplaatst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar đang giữ bố cục trong lúc macOS tạm ẩn hoặc chuyển mục thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar กำลังกันเลย์เอาต์ไว้ ขณะที่ macOS ซ่อนหรือย้ายรายการแถบเมนูชั่วคราว"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar melindungi tata letak saat macOS sementara menyembunyikan atau memindahkan item."
          }
        }
      }
    },
