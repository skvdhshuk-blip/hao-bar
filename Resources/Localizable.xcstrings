    "Grid view for browsing and organizing icons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid view for browsing and organizing icons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用网格浏览和整理图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用格線瀏覽和整理圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドでアイコンを見て整理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격자에서 아이콘을 둘러보고 정리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasteransicht zum Durchsuchen und Ordnen von Symbolen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grille pour parcourir et classer les icônes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista de cuadrícula para explorar y organizar iconos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grade para explorar e organizar ícones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Griglia per sfogliare e organizzare le icone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasterweergave om pictogrammen te bekijken en te ordenen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưới để duyệt và sắp xếp biểu tượng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองตารางสำหรับเรียกดูและจัดไอคอน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan kisi untuk menelusuri dan merapikan ikon."
          }
        }
      }
    },
    "Hands-off: HaoBar only fixes its icon layout at startup or when you click Fix.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-off: HaoBar only fixes its icon layout at startup or when you click Fix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少干预：HaoBar 只在启动时或你点「修复」时整理图标布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "少干預：HaoBar 只在啟動時或你點「修復」時整理圖示佈局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手を出さない：HaoBarは起動時か「修復」をクリックしたときだけレイアウトを直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손 안 댐: HaoBar는 시작할 때나 ‘고치기’를 눌렀을 때만 아이콘 레이아웃을 고칩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückhaltend: HaoBar richtet das Symbol-Layout nur beim Start oder nach einem Klick auf „Reparieren“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discret : HaoBar ne corrige la disposition qu’au démarrage ou quand vous cliquez sur Réparer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin interferir: HaoBar solo corrige el diseño al arrancar o al pulsar Reparar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem interferir: o HaoBar só corrige o layout na abertura ou ao clicar em Reparar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani in tasca: HaoBar sistema il layout solo all’avvio o quando fai clic su Ripara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-off: HaoBar herstelt de layout alleen bij het opstarten of als je op Herstel klikt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ít can thiệp: HaoBar chỉ sửa bố cục lúc khởi động hoặc khi bạn bấm Sửa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ยุ่ง: HaoBar จัดเลย์เอาต์ไอคอนเฉพาะตอนเปิดเครื่อง หรือเมื่อคุณคลิกซ่อม"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa campur: HaoBar merapikan tata letak hanya saat mulai atau saat Anda klik Perbaiki."
          }
        }
      }
    },
    "Hands-off: HaoBar only fixes its icon layout when it starts or when you click Fix. Good if your setup rarely changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-off: HaoBar only fixes its icon layout when it starts or when you click Fix. Good if your setup rarely changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少干预：HaoBar 只在启动或你点「修复」时整理布局。布局很少变时很合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "少干預：HaoBar 只在啟動或你點「修復」時整理佈局。佈局很少變時很合適。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手を出さない：起動時か「修復」のときだけ直します。構成がほとんど変わらない人向け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손 안 댐: 시작할 때나 ‘고치기’를 눌렀을 때만 고칩니다. 구성이 잘 안 바뀌면 좋아요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückhaltend: Nur beim Start oder nach „Reparieren“. Gut, wenn sich wenig ändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discret : seulement au démarrage ou via Réparer. Idéal si rien ne bouge souvent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin interferir: solo al arrancar o al pulsar Reparar. Bien si casi no cambia nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem interferir: só na abertura ou ao clicar em Reparar. Bom se quase nada muda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mani in tasca: solo all’avvio o con Ripara. Ideale se cambi poco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-off: alleen bij opstarten of Herstel. Fijn als er weinig verandert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ít can thiệp: chỉ lúc mở app hoặc bấm Sửa. Hợp nếu bố trí ít đổi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ยุ่ง: แก้เฉพาะตอนเปิดหรือคลิกซ่อม เหมาะถ้าชุดไอคอนแทบไม่เปลี่ยน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa campur: hanya saat mulai atau Perbaiki. Cocok jika jarang berubah."
          }
        }
      }
    },
    "HaoBar": {
      "shouldTranslate": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar"
          }
        }
      }
    },
    "HaoBar also re-checks the layout after sleep/wake and when displays are connected or disconnected. Good if icons sometimes scramble after wake.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar also re-checks the layout after sleep/wake and when displays are connected or disconnected. Good if icons sometimes scramble after wake."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠/唤醒以及插拔显示器后，HaoBar 也会再检查布局。唤醒后图标会乱时很合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠／喚醒以及插拔顯示器後，HaoBar 也會再檢查佈局。喚醒後圖示會亂時很合適。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ解除やディスプレイの着脱後もレイアウトを再確認。起きるとアイコンが崩れる人向け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기/깨우기나 디스플레이 연결·해제 후에도 레이아웃을 다시 봅니다. 깨운 뒤 아이콘이 흐트러질 때 좋아요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar prüft das Layout auch nach Ruhezustand und wenn Displays kommen oder gehen. Gut, wenn Symbole nach dem Aufwachen verrutschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar revérifie aussi après sommeil/réveil et branchement d’écrans. Utile si les icônes partent en vrille au réveil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar también revisa tras dormir/despertar y al conectar o quitar pantallas. Útil si los iconos se desordenan al despertar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar também revê após dormir/acordar e ao ligar ou desligar telas. Bom se os ícones se embaralham ao acordar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ricontrolla anche dopo sonno/risveglio e attacco/stacco display. Utile se le icone si scombinano al risveglio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar controleert ook na slaap/ontwaken en als schermen erbij komen of weggaan. Fijn als pictogrammen na ontwaken schuiven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar cũng kiểm lại sau ngủ/đánh thức và khi gắn/rút màn hình. Hợp nếu icon bị loạn lúc thức."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ตรวจเลย์เอาต์อีกครั้งหลังหลับ/ตื่น และตอนต่อหรือถอดจอ เหมาะถ้าไอคอนเพี้ยนหลังตื่น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar juga memeriksa ulang setelah tidur/bangun dan saat layar disambung atau dilepas. Cocok jika ikon berantakan setelah bangun."
          }
        }
      }
    },
    "HaoBar also re-checks the layout after sleep/wake, display changes, and session changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar also re-checks the layout after sleep/wake, display changes, and session changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠/唤醒、显示器变化和会话切换后，HaoBar 也会再检查布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠／喚醒、顯示器變化和工作階段切換後，HaoBar 也會再檢查佈局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ解除、ディスプレイ変更、セッション変更のあとも再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자기/깨우기, 디스플레이 변경, 세션 변경 후에도 레이아웃을 다시 봅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar prüft auch nach Ruhezustand, Display- und Sitzungswechseln erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar revérifie aussi après sommeil/réveil, changement d’écran et de session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar también revisa tras dormir/despertar, cambios de pantalla y de sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar também revê após dormir/acordar, mudanças de tela e de sessão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ricontrolla anche dopo sonno/risveglio, cambi di display e di sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar controleert ook na slaap/ontwaken, scherm- en sessiewijzigingen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar cũng kiểm lại sau ngủ/đánh thức, đổi màn hình và đổi phiên."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ตรวจอีกครั้งหลังหลับ/ตื่น เปลี่ยนจอ และเปลี่ยนเซสชัน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar juga memeriksa ulang setelah tidur/bangun, perubahan layar, dan sesi."
          }
        }
      }
    },
    "HaoBar can import your Bartender layout and matching settings from the detected plist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar can import your Bartender layout and matching settings from the detected plist."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 可以从检测到的 plist 导入你的 Bartender 布局和对应设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 可以從偵測到的 plist 輸入你的 Bartender 佈局和對應設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出したplistからBartenderのレイアウトと設定を読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지된 plist에서 Bartender 레이아웃과 맞는 설정을 가져올 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kann dein Bartender-Layout und passende Einstellungen aus der erkannten Plist importieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar peut importer votre disposition Bartender et les réglages associés depuis le plist détecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar puede importar tu disposición de Bartender y los ajustes del plist detectado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar pode importar seu layout do Bartender e os ajustes do plist detectado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar può importare il layout di Bartender e le impostazioni dal plist rilevato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kan je Bartender-layout en bijbehorende instellingen uit de gevonden plist importeren."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar có thể nhập bố cục Bartender và cài đặt khớp từ plist đã thấy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar นำเข้าเลย์เอาต์ Bartender และการตั้งค่าที่คู่กันจาก plist ที่ตรวจพบได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar dapat mengimpor tata letak Bartender dan pengaturan yang cocok dari plist terdeteksi."
          }
        }
      }
    },
    "HaoBar can import your Ice settings here, but Ice does not store icon positions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar can import your Ice settings here, but Ice does not store icon positions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 可以在这里导入 Ice 设置，但 Ice 不保存图标位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 可以在這裡輸入 Ice 設定，但 Ice 不儲存圖示位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここからIceの設定を読み込めますが、Iceはアイコン位置を保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 Ice 설정을 가져올 수 있지만, Ice는 아이콘 위치를 저장하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kann deine Ice-Einstellungen hier importieren; Ice speichert aber keine Symbolpositionen."
