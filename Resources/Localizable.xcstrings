        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores the saved layout point, recreates HaoBar's menu bar items, then runs the same repair path as Arrange Now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复已保存的布局点，重新创建 HaoBar 的菜单栏项目，然后走与「立即整理」相同的修复路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復已儲存的佈局點，重新建立 HaoBar 的選單列項目，然後走與「立即整理」相同的修復路徑。"
          }
        }
      }
    },
    "Reveal battery and power icons automatically when battery is low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal battery and power icons automatically when battery is low"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量低时自动显示电池和电源相关图标。"
