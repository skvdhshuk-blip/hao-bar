        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un script propio decide cuándo mostrar u ocultar los iconos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um script seu decide quando mostrar ou ocultar os ícones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno script tuo decide quando mostrare o nascondere le icone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eigen script bepaalt wanneer verborgen iconen verschijnen of verdwijnen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng script của bạn để quyết hiện hay ẩn biểu tượng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สคริปต์ของคุณเองตัดสินว่าจะแสดงหรือซ่อนไอคอนเมื่อใด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai skrip Anda sendiri untuk menentukan kapan ikon muncul atau tersembunyi."
          }
        }
      }
    },
    "Show Hidden Bar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Hidden Bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示隐藏条"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示隱藏列"
          }
        }
      }
    },
    "Keep visible icons right of the notch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep visible icons right of the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见图标只留在刘海右侧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可見圖示只留在瀏海右側"
          }
        }
      }
    },
    "On notched Macs, extra visible icons move to Hidden. Click HaoBar to open them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On notched Macs, extra visible icons move to Hidden. Click HaoBar to open them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海屏上，多出来的可见图标会进隐藏。点 HaoBar 即可打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海螢幕上，多出來的可見圖示會進入隱藏。點 HaoBar 即可打開。"
          }
        }
      }
    },
    "Left-click the HaoBar icon to show hidden icons in a bar under the menu bar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left-click the HaoBar icon to show hidden icons in a bar under the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左键点 HaoBar 图标，在菜单栏下方显示隐藏图标条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左鍵點 HaoBar 圖示，在選單列下方顯示隱藏圖示列。"
          }
        }
      }
    },
    "Screen Recording — menu bar only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording — menu bar only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕录制 — 只截菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕錄製 — 只擷取選單列。"
          }
        }
      }
    },
    "No video recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No video recording."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不录像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不錄影。"
          }
        }
      }
    },
    "HaoBar captures the menu bar so hidden icons can appear in the popup bar. It does not record video or upload anything.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar captures the menu bar so hidden icons can appear in the popup bar. It does not record video or upload anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 只截菜单栏，好在弹条里显示隐藏图标。不录像，也不上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 只擷取選單列，以便在彈出列顯示隱藏圖示。不錄影，也不上傳。"
          }
        }
      }
    },
    "macOS may show a purple screen-capture indicator while HaoBar snapshots the menu bar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS may show a purple screen-capture indicator while HaoBar snapshots the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 截菜单栏时，系统可能出现紫色「正在截屏」提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 擷取選單列時，系統可能出現紫色「正在截取畫面」提示。"
          }
        }
      }
    },
    "Open Screen Recording Settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Screen Recording Settings"
          }
        },
