    },
    "HaoBar cannot save this layout yet because its menu bar positions need checking. Run Arrange Now, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar cannot save this layout yet because its menu bar positions need checking. Run Arrange Now, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 还不能保存此布局，因为菜单栏位置需要检查。请先点「立即整理」，然后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
