          "stringUnit": {
            "state": "translated",
            "value": "手勢只會顯示隱藏圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャは非表示アイコンを出すだけです。"
          }
        },
