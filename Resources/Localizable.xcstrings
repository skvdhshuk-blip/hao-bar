    "Nothing is in the always-hidden zone.\nDrag an icon onto the glowing Always Hidden tab or use the context menu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is in the always-hidden zone.\nDrag an icon onto the glowing Always Hidden tab or use the context menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终隐藏区是空的。\n把图标拖到发光的「始终隐藏」标签上，或用快捷菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律隱藏區是空的。\n把圖示拖到發光的「一律隱藏」標籤上，或用快速選單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に非表示ゾーンは空です。\n光る「常に非表示」タブにドロップするか、コンテキストメニューを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 숨김 영역이 비어 있습니다.\n빛나는 ‘항상 숨김’ 탭으로 드래그하거나 컨텍스트 메뉴를 쓰세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Zone „Immer ausgeblendet“ ist nichts.\nZiehe ein Symbol auf den leuchtenden Tab oder nutze das Kontextmenü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone Toujours masqué est vide.\nDéposez une icône sur l’onglet lumineux ou utilisez le menu contextuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada en Siempre oculto.\nArrastra un icono a la pestaña iluminada o usa el menú contextual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada na zona Sempre oculto.\nArraste um ícone até a aba iluminada ou use o menu contextual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona Sempre nascosto è vuota.\nTrascina un’icona sulla scheda luminosa o usa il menu di scelta rapida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zone Altijd verborgen is leeg.\nSleep een pictogram op het oplichtende tabblad of gebruik het contextmenu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng luôn ẩn đang trống.\nKéo biểu tượng vào tab Luôn ẩn đang sáng, hoặc dùng menu ngữ cảnh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โซนซ่อนตลอดว่างอยู่\nลากไอคอนไปที่แท็บซ่อนตลอดที่เรืองแสง หรือใช้เมนูคลิกขวา"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona selalu tersembunyi kosong.\nSeret ikon ke tab Selalu tersembunyi yang menyala, atau pakai menu konteks."
          }
        }
      }
    },
