    "Everything stays on this Mac. No account, no upload.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this Mac. No account, no upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据只留在这台 Mac。不用账号，也不上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料只留在這台 Mac。不用帳號，也不上傳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてはこのMacの中。アカウントもアップロードも不要。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 건 이 Mac에만 남습니다. 계정 없고, 업로드도 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Mac. Kein Account, kein Upload."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur ce Mac. Pas de compte, pas d’envoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este Mac. Sin cuenta ni subidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste Mac. Sem conta, sem envio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo Mac. Niente account, niente caricamenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op deze Mac. Geen account, geen upload."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ ở lại máy Mac này. Không tài khoản, không tải lên."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างอยู่บน Mac เครื่องนี้ ไม่มีบัญชี ไม่ได้อัปโหลด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap di Mac ini. Tanpa akun, tanpa unggah."
          }
        }
      }
    },
    "Exit code 0 = show hidden icons, non-zero = hide.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit code 0 = show hidden icons, non-zero = hide."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出码 0 = 显示隐藏图标，非 0 = 隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束代碼 0 = 顯示隱藏圖示，非 0 = 隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了コード0で非表示アイコンを表示、それ以外は隠す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 코드 0이면 가려진 아이콘을 표시하고, 그 외는 가립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exitcode 0 = ausgeblendete Symbole zeigen, sonst ausblenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de sortie 0 = afficher les icônes masquées, autre = masquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código 0 = mostrar iconos ocultos; distinto de 0 = ocultar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código 0 = mostrar ícones ocultos; diferente de 0 = ocultar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice 0 = mostra le icone nascoste; diverso da 0 = nascondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exitcode 0 = verborgen pictogrammen tonen, anders verbergen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã thoát 0 = hiện biểu tượng ẩn, khác 0 = ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสออก 0 = แสดงไอคอนที่ซ่อน ค่าอื่น = ซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode keluar 0 = tampilkan ikon tersembunyi, selain itu = sembunyikan."
          }
        }
      }
    },
