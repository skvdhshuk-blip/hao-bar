    "Despite the many kind reviews and steady downloads, that is not sustainable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Despite the many kind reviews and steady downloads, that is not sustainable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽管好评不少、下载也稳定，这样仍难以为继。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儘管好評不少、下載也穩定，這樣仍難以長久。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがたいレビューと安定したダウンロードがあっても、これでは続きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 리뷰와 꾸준한 다운로드에도, 이런 식으로는 버티기 어렵습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotz vieler freundlicher Bewertungen und stetiger Downloads ist das nicht tragfähig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malgré de nombreux avis gentils et des téléchargements stables, ce n’est pas tenable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pese a las reseñas amables y las descargas constantes, esto no es sostenible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo com avaliações gentis e downloads estáveis, isso não se sustenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonostante le recensioni gentili e i download costanti, non è sostenibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondanks lieve recensies en gestage downloads is dit niet houdbaar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù nhiều lời khen và tải đều, như vậy không bền được."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้รีวิวดีและดาวน์โหลดสม่ำเสมอ แต่แบบนี้ไปต่อไม่ไหว"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meski banyak ulasan baik dan unduhan stabil, ini tidak berkelanjutan."
          }
        }
      }
    },
