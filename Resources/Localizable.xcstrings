        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Nutze die Chips oben, um Reihen ein- oder auszublenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Utilisez les pastilles ci-dessus pour afficher ou masquer des rangées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Usa las pastillas de arriba para mostrar u ocultar filas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Use os chips acima para mostrar ou ocultar linhas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Usa i chip in alto per mostrare o nascondere le righe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Gebruik de chips hierboven om rijen te tonen of te verbergen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Dùng thẻ phía trên để hiện hoặc ẩn hàng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "4. ใช้ชิปด้านบนเพื่อแสดงหรือซ่อนแถว"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Gunakan chip di atas untuk menampilkan atau menyembunyikan baris."
          }
        }
      }
    },
    ": ⌘ + drag icons in your menu bar to rearrange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + drag icons in your menu bar to rearrange"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：按住 ⌘ 拖动菜单栏图标即可重新排列"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：按住 ⌘ 拖曳選單列圖示即可重新排列"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "：メニューバーで ⌘ を押しながらアイコンをドラッグして並べ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ": 메뉴 막대에서 ⌘을 누른 채 아이콘을 드래그하면 순서를 바꿀 수 있습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ halten und Symbole in der Menüleiste ziehen, um sie neu anzuordnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " : ⌘ + faites glisser les icônes dans la barre des menus pour les réorganiser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + arrastra los iconos en la barra de menús para reordenarlos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + arraste os ícones na barra de menus para reorganizá-los"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + trascina le icone nella barra dei menu per riordinarle"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + sleep pictogrammen in de menubalk om ze te herschikken"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + kéo biểu tượng trên thanh menu để sắp xếp lại"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ": กด ⌘ แล้วลากไอคอนบนแถบเมนูเพื่อจัดเรียงใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ": ⌘ + seret ikon di bilah menu untuk menyusun ulang"
          }
        }
      }
    },
