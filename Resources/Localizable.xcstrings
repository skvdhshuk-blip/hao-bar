        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar puede ejecutar Organizar ahora para actualizar anclas antiguas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar pode executar Organizar agora para atualizar âncoras antigas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar può eseguire Disponi ora per aggiornare vecchie ancore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kan Nu ordenen uitvoeren om oudere ankerposities te vernieuwen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar có thể chạy Sắp xếp ngay để làm mới mốc neo cũ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar รันจัดเรียงทันทีเพื่อรีเฟรชตำแหน่งจุดยึดเก่าได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar dapat menjalankan Atur sekarang untuk menyegarkan posisi jangkar lama."
          }
        }
      }
    },
    "HaoBar can see the expected visible, hidden, and always-hidden item groups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar can see the expected visible, hidden, and always-hidden item groups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 能看到预期的可见、隐藏和始终隐藏分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
