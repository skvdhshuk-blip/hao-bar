    "Settings → General → Browse Icons. Switch between Icon Panel and Second Menu Bar anytime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → General → Browse Icons. Switch between Icon Panel and Second Menu Bar anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 → 通用 → 浏览图标。随时可在图标面板和第二菜单栏之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 一般 → 瀏覽圖示。隨時可在圖示面板和第二選單列之間切換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 一般 → アイコンを表示。アイコンパネルとセカンドメニューバーはいつでも切り替え。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 일반 → 아이콘 둘러보기. 아이콘 패널과 두 번째 메뉴 막대는 언제든 바꿀 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen → Allgemein → Symbole durchsuchen. Jederzeit zwischen Symbolpanel und zweiter Menüleiste wechseln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages → Général → Parcourir les icônes. Passez quand vous voulez du panneau à la seconde barre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → General → Explorar iconos. Cambia cuando quieras entre panel y segunda barra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → Geral → Explorar ícones. Alterne quando quiser entre painel e segunda barra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni → Generali → Sfoglia icone. Passa quando vuoi dal pannello alla seconda barra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen → Algemeen → Pictogrammen bekijken. Wissel wanneer je wilt tussen paneel en tweede menubalk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt → Chung → Duyệt biểu tượng. Đổi giữa bảng icon và thanh menu thứ hai lúc nào cũng được."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่า → ทั่วไป → เรียกดูไอคอน สลับระหว่างแผงไอคอนกับแถบเมนูที่สองได้ทุกเมื่อ"
          }
