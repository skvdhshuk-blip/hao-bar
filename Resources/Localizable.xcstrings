    "but of power and of love and of a sound mind.\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "but of power and of love and of a sound mind.\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "乃是刚强、仁爱、谨守的心。」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "乃是剛強、仁愛、謹守的心。」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力と愛と思慮の霊をわたしたちにくださったのです。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오직 능력과 사랑과 절제하는 마음이니」"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "sondern der Kraft und der Liebe und der Besonnenheit.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mais un esprit de force, d’amour et de sagesse. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sino de poder, de amor y de dominio propio. »"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "mas de poder, de amor e de moderação. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ma di forza, di amore e di senno. »"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "maar van kracht, van liefde en van bezonnenheid.“"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "bèn là tâm thần mạnh mẽ, có tình thương yêu và kỷ luật. »"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ทรงประทานจิตใจที่ประกอบด้วยฤทธิ์เดช ความรัก และการบังคับตนเอง »"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "melainkan roh yang membangkitkan kekuatan, kasih, dan ketertiban. »"
          }
        }
      }
    },
