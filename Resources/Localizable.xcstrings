    "Arrange Now uses the same layout rescue path available later in Health.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange Now uses the same layout rescue path available later in Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「立即整理」走的是稍后在「健康状况」里也能用的同一条布局抢救路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「立即整理」走的是稍後在「健康狀態」裡也能用的同一條佈局搶救路徑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今すぐ整列」は、あとで「状態」でも使える同じレイアウト救済の流れです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘지금 정렬’은 나중에 ‘상태’에서도 쓰는 것과 같은 레이아웃 복구 경로입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jetzt anordnen“ nutzt denselben Rettungsweg, der später unter Zustand bereitsteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiser maintenant emprunte le même chemin de sauvetage que Santé plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizar ahora usa la misma vía de rescate que luego verás en Salud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizar agora usa o mesmo caminho de resgate disponível depois em Integridade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponi ora usa lo stesso percorso di recupero che poi trovi in Integrità."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ordenen gebruikt hetzelfde herstelpad dat later onder Gezondheid staat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp ngay dùng cùng đường cứu bố cục, sau này cũng có trong Tình trạng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเรียงทันทีใช้เส้นทางกู้เลย์เอาต์เดียวกับที่จะเจอในสุขภาพ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur sekarang memakai jalur penyelamatan tata letak yang sama dengan Kesehatan nanti."
          }
        }
      }
    },
