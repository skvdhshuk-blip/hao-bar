    "Saves the current HaoBar icon, divider, spacer, display-backup, and always-hidden divider positions as the restore point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the current HaoBar icon, divider, spacer, display-backup, and always-hidden divider positions as the restore point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把当前 HaoBar 图标、分隔符、间隔、显示器备份和始终隐藏分隔的位置存为还原点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把目前 HaoBar 圖示、分隔符、間隔、顯示器備份和一律隱藏分隔的位置存為還原點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のHaoBarアイコン、区切り、スペーサー、ディスプレイバックアップ、常に非表示区切りの位置を復元ポイントに保存。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 HaoBar 아이콘, 구분선, 간격, 디스플레이 백업, 항상 숨김 구분선 위치를 복원 지점으로 저장합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert die aktuellen Positionen von HaoBar-Symbol, Trenner, Abstandhalter, Display-Backup und Immer-ausgeblendet-Trenner als Wiederherstellungspunkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les positions actuelles de l’icône HaoBar, des séparateurs, des espaces, de la sauvegarde d’écran et du séparateur toujours masqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las posiciones actuales del icono HaoBar, divisores, espacios, copia de pantalla y divisor siempre oculto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva as posições atuais do ícone HaoBar, divisores, espaços, backup de tela e divisor sempre oculto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le posizioni attuali dell’icona HaoBar, divisori, spaziatori, backup display e divisore sempre nascosto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart de huidige posities van HaoBar-pictogram, scheidingen, spaties, schermback-up en altijd-verborgen scheiding."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu vị trí hiện tại của icon HaoBar, đường chia, khoảng trống, bản sao màn hình và đường chia luôn ẩn làm điểm khôi phục."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกตำแหน่งไอคอน HaoBar เส้นแบ่ง ตัวเว้น จอสำรอง และเส้นแบ่งซ่อนตลอด เป็นจุดคืนค่า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan posisi ikon HaoBar, pemisah, spacer, cadangan layar, dan pemisah selalu tersembunyi sebagai titik pemulihan."
          }
        }
      }
    },
    "Saves the current menu bar layout as HaoBar's first rescue point.": {
      "localizations": {
        "en": {
