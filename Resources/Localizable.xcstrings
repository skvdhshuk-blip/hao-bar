    "Runs a layout repair check now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a layout repair check now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即运行布局修复检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即執行佈局修復檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐレイアウト修復確認を実行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 레이아웃 복구 확인을 실행합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt jetzt eine Layoutreparaturprüfung aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance une vérification de réparation de la disposition maintenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta ahora una comprobación de reparación de la disposición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa agora uma verificação de reparo do layout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue ora un controllo di riparazione del layout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voert nu een lay-outherstelcontrole uit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy kiểm tra sửa bố cục ngay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รันตรวจซ่อมเลย์เอาต์ตอนนี้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjalankan pemeriksaan perbaikan tata letak sekarang."
          }
        }
      }
    },
    "Runs an immediate layout check, refreshes menu bar anchor positions, and repairs HaoBar's visible, hidden, and always-hidden groups if needed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs an immediate layout check, refreshes menu bar anchor positions, and repairs HaoBar's visible, hidden, and always-hidden groups if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即检查布局、刷新菜单栏锚点，并在需要时修复 HaoBar 的可见、隐藏和始终隐藏分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即檢查佈局、重新整理選單列錨點，並在需要時修復 HaoBar 的可見、隱藏和一律隱藏群組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにレイアウトを確認し、アンカーを更新。必要なら表示・非表示・常に非表示グループを修復。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 레이아웃을 확인하고 앵커를 새로고침하며, 필요하면 표시됨·숨김·항상 숨김 그룹을 고칩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft das Layout sofort, aktualisiert Anker und repariert bei Bedarf die Gruppen Sichtbar, Ausgeblendet und Immer ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la disposition, rafraîchit les ancrages et répare si besoin les groupes Visible, Masqué et Toujours masqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la disposición, actualiza anclas y repara si hace falta Visible, Oculto y Siempre oculto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica o layout, atualiza âncoras e repara se preciso Visível, Oculto e Sempre oculto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il layout, aggiorna le ancore e ripara se serve Visibile, Nascosto e Sempre nascosto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert de lay-out, ververst ankers en herstelt zo nodig Zichtbaar, Verborgen en Altijd verborgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm bố cục ngay, làm mới mốc neo, và sửa nhóm Hiện, Ẩn, Luôn ẩn nếu cần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจเลย์เอาต์ทันที รีเฟรชจุดยึด และซ่อมกลุ่มแสดง ซ่อน ซ่อนตลอดถ้าต้อง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa tata letak, menyegarkan jangkar, dan memperbaiki grup Terlihat, Tersembunyi, serta Selalu tersembunyi bila perlu."
          }
        }
      }
    },
