    "Mr. Sane here. I need to share an insane stat with you all.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane here. I need to share an insane stat with you all."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我是 Mr. Sane。有个离谱的数字得跟大家说一声。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我是 Mr. Sane。有個離譜的數字得跟大家說一聲。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Saneです。ちょっと非常識な数字を共有させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane입니다. 좀 말도 안 되는 숫자를 나눠야겠습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane hier. Ich muss eine irre Zahl mit euch teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est Mr. Sane. J’ai une stat folle à vous raconter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy Mr. Sane. Tengo una estadística de locos que contaros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui é o Mr. Sane. Preciso contar uma estatística maluca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono Mr. Sane. Devo condividere una statistica pazzesca."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane hier. Ik moet een waanzinnig cijfer met jullie delen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane đây. Có một con số điên điên phải kể các bạn nghe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane นะ มีตัวเลขบ้าๆ ที่อยากเล่าให้ฟัง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mr. Sane di sini. Ada angka gila yang perlu saya ceritakan."
          }
        }
      }
    },
