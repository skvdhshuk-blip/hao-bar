    "No Focus Modes configured. Enable a Focus Mode in System Settings to add it here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Focus Modes configured. Enable a Focus Mode in System Settings to add it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有配置 Focus。先在系统设置里打开一个 Focus，再添加到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有設定 Focus。先在系統設定裡打開一個 Focus，再加到這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Focusがまだありません。システム設定でFocusをオンにしてから追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성된 Focus가 없습니다. 시스템 설정에서 Focus를 켠 뒤 여기에 추가하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Focus-Modi eingerichtet. Aktiviere einen Focus in den Systemeinstellungen, um ihn hier hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mode Focus. Activez-en un dans Réglages Système pour l’ajouter ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay modos Focus. Activa uno en Ajustes del Sistema para añadirlo aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modo Focus. Ative um em Ajustes do Sistema para adicioná-lo aqui."
          }
