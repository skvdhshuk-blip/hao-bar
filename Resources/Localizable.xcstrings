          }
        }
      }
    },
    "The first restore point lets HaoBar return to the current known-good layout later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first restore point lets HaoBar return to the current known-good layout later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一个还原点让 HaoBar 之后能回到当前这个已知正常的布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個還原點讓 HaoBar 之後能回到目前這個已知正常的佈局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の復元ポイントがあれば、あとで今の正常なレイアウトに戻れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 복원 지점이 있으면 HaoBar가 나중에 지금 이 정상 레이아웃으로 돌아갈 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Wiederherstellungspunkt lässt HaoBar später zu diesem bekannten guten Layout zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier point de restauration permet à HaoBar de revenir plus tard à cette disposition saine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer punto de restauración permite a HaoBar volver después a esta disposición correcta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro ponto de restauração permite ao HaoBar voltar depois a este layout conhecido como bom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo punto di ripristino permette a HaoBar di tornare più tardi a questo layout valido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het eerste herstelpunt laat HaoBar later terugkeren naar deze bekende goede lay-out."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm khôi phục đầu giúp HaoBar sau này quay lại bố cục đang ổn này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดคืนค่าแรกให้ HaoBar กลับมาที่เลย์เอาต์ที่ดีตอนนี้ได้ทีหลัง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik pemulihan pertama memungkinkan HaoBar kembali ke tata letak yang sudah terbukti baik ini."
          }
        }
      }
    },
    "The menu bar is getting crowded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar is getting crowded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏有点挤了。"
          }
        },
        "zh-Hant": {
