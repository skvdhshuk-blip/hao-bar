    "Temporarily hides File/Edit/View if needed to make room in the menu bar. Only affects inline reveal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporarily hides File/Edit/View if needed to make room in the menu bar. Only affects inline reveal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必要时暂时隐藏文件/编辑/显示，给菜单栏腾地方。只影响就地显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時暫時隱藏檔案／編輯／顯示，給選單列騰位置。只影響就地顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要ならファイル/編集/表示を一時的に隠し、メニューバーのスペースを確保。インライン表示にのみ影響。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요하면 파일/편집/보기 메뉴를 잠시 가려 메뉴 막대 자리를 만듭니다. 인라인 표시에만 영향이 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Datei/Bearbeiten/Darstellung vorübergehend aus, wenn Platz nötig ist. Betrifft nur die Inline-Einblendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque temporairement Fichier/Édition/Présentation si besoin. N’affecte que l’affichage en ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta temporalmente Archivo/Edición/Visualización si hace falta sitio. Solo afecta a la revelación en línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta temporariamente Arquivo/Editar/Visualizar se precisar de espaço. Só afeta a revelação em linha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde temporaneamente File/Modifica/Vista se serve spazio. Interessa solo la rivelazione in linea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergt tijdelijk Archief/Wijzig/Weergave als er ruimte nodig is. Alleen van invloed op inline tonen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm ẩn Tệp/Sửa/Xem nếu cần chỗ trên thanh menu. Chỉ ảnh hưởng hiện tại chỗ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนไฟล์/แก้ไข/แสดงชั่วคราวถ้าต้องมีที่ว่าง กระทบเฉพาะการเผยแบบอินไลน์"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan File/Edit/Tampilan sementara jika perlu ruang. Hanya memengaruhi tampilan sebaris."
          }
        }
      }
    },
