    "Hover near the menu bar to reveal hidden icons inline. Click the HaoBar icon to open or toggle manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover near the menu bar to reveal hidden icons inline. Click the HaoBar icon to open or toggle manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把指针移近菜单栏即可就地显示隐藏图标。点击 HaoBar 图标可手动打开或切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把指標移近選單列即可就地顯示隱藏圖示。點 HaoBar 圖示可手動打開或切換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー近くにポインタを置くと、その場で非表示アイコンが出ます。HaoBarアイコンで手動切り替え。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 근처에 포인터를 두면 가려진 아이콘이 그 자리에서 나타납니다. HaoBar 아이콘을 눌러 직접 열고 전환하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige ausgeblendete Symbole inline, wenn der Zeiger nahe der Menüleiste ist. Klick auf HaoBar öffnet oder schaltet manuell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez la barre des menus pour afficher les icônes masquées sur place. Cliquez sur HaoBar pour ouvrir ou basculer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el puntero cerca de la barra para revelar iconos en su sitio. Haz clic en HaoBar para abrir o alternar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o ponteiro perto da barra para revelar ícones no lugar. Clique no HaoBar para abrir ou alternar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina il puntatore alla barra per mostrare le icone sul posto. Fai clic su HaoBar per aprire o commutare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg bij de menubalk om verborgen pictogrammen ter plekke te tonen. Klik op HaoBar om handmatig te openen of te schakelen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa con trỏ gần thanh menu để hiện biểu tượng ẩn tại chỗ. Bấm biểu tượng HaoBar để mở hoặc gạt tay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาตัวชี้ใกล้แถบเมนูเพื่อเผยไอคอนที่ซ่อนตรงนั้น คลิกไอคอน HaoBar เพื่อเปิดหรือสลับเอง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan dekat bilah menu untuk menampilkan ikon tersembunyi di tempat. Klik ikon HaoBar untuk membuka atau menyalakan manual."
          }
        }
      }
    },
