          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 확인과 레이아웃 복원 지점 저장으로 설정을 마칩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Einrichtung mit einer Berechtigungsprüfung und einem gespeicherten Wiederherstellungspunkt ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez avec une vérification d’autorisation et un point de restauration de la disposition."
          }
        },
        "es": {
