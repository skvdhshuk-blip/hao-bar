    "All your menu bar icons are hidden.\nUse ⌘-drag to show icons right of the separator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your menu bar icons are hidden.\nUse ⌘-drag to show icons right of the separator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏图标都藏起来了。\n按住 ⌘ 拖动，把要显示的图标放到分隔符右边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列圖示都藏起來了。\n按住 ⌘ 拖曳，把要顯示的圖示放到分隔符右邊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアイコンはすべて非表示です。\n⌘ドラッグで、表示したいアイコンを区切りの右へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘이 모두 가려져 있습니다.\n⌘ 드래그로 구분선 오른쪽에 두면 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Menüleisten-Symbole sind ausgeblendet.\nMit ⌘-Ziehen Symbole rechts vom Trenner sichtbar machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les icônes de la barre des menus sont masquées.\nFaites-les glisser avec ⌘ à droite du séparateur pour les afficher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los iconos de la barra de menús están ocultos.\nArrastra con ⌘ a la derecha del separador para mostrarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ícones da barra de menus estão ocultos.\nArraste com ⌘ para a direita do separador para mostrá-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le icone della barra dei menu sono nascoste.\nTrascinale con ⌘ a destra del separatore per mostrarle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je menubalkpictogrammen zijn verborgen.\nSleep ze met ⌘ rechts van de scheiding om ze te tonen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi biểu tượng thanh menu đang ẩn.\nGiữ ⌘ kéo sang phải dấu phân cách để hiện chúng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนแถบเมนูถูกซ่อนหมดแล้ว\nกด ⌘ ค้างแล้วลากไปทางขวาของตัวแบ่งเพื่อแสดง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ikon bilah menu tersembunyi.\nSeret dengan ⌘ ke kanan pemisah agar terlihat."
          }
        }
      }
    },
    "All your menu bar icons are visible.\nUse ⌘-drag to hide icons left of the separator.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your menu bar icons are visible.\nUse ⌘-drag to hide icons left of the separator."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏图标都在显示。\n按住 ⌘ 拖动，把要隐藏的图标放到分隔符左边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列圖示都在顯示。\n按住 ⌘ 拖曳，把要隱藏的圖示放到分隔符左邊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアイコンはすべて表示中です。\n⌘ドラッグで、隠したいアイコンを区切りの左へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘이 모두 보입니다.\n⌘ 드래그로 구분선 왼쪽에 두면 가려집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Menüleisten-Symbole sind sichtbar.\nMit ⌘-Ziehen Symbole links vom Trenner ausblenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les icônes de la barre des menus sont visibles.\nFaites-les glisser avec ⌘ à gauche du séparateur pour les masquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los iconos de la barra de menús están visibles.\nArrastra con ⌘ a la izquierda del separador para ocultarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ícones da barra de menus estão visíveis.\nArraste com ⌘ para a esquerda do separador para ocultá-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le icone della barra dei menu sono visibili.\nTrascinale con ⌘ a sinistra del separatore per nasconderle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je menubalkpictogrammen zijn zichtbaar.\nSleep ze met ⌘ links van de scheiding om ze te verbergen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi biểu tượng thanh menu đang hiện.\nGiữ ⌘ kéo sang trái dấu phân cách để ẩn chúng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนแถบเมนูแสดงอยู่ทั้งหมด\nกด ⌘ ค้างแล้วลากไปทางซ้ายของตัวแบ่งเพื่อซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ikon bilah menu terlihat.\nSeret dengan ⌘ ke kiri pemisah agar tersembunyi."
          }
        }
      }
    },
