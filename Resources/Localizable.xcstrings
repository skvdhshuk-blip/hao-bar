            "state": "translated",
            "value": "Obrigado por ajudar a tornar a SaneApps possível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per rendere possibile SaneApps."
          }
        },
        "nl": {
