    "Live checks after wake and display changes if your icons drift.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live checks after wake and display changes if your icons drift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒或显示器变化后实时检查，免得图标跑偏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喚醒或顯示器變化後即時檢查，免得圖示跑掉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ解除やディスプレイ変更のあとライブ確認。アイコンがずれたときに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨우거나 디스플레이가 바뀐 뒤 실시간으로 확인합니다. 아이콘이 밀릴 때."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Prüfungen nach Aufwachen und Displaywechsel, wenn Symbole verrutschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôles en direct après réveil et changement d’écran si les icônes dérivent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobaciones en vivo tras despertar o cambiar de pantalla si los iconos se desplazan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificações ao vivo após acordar ou mudar de tela se os ícones saírem do lugar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlli live dopo risveglio e cambio display se le icone si spostano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Livecontroles na ontwaken en schermwissel als pictogrammen verschuiven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm trực tiếp sau đánh thức và đổi màn nếu icon bị lệch."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจแบบสดหลังตื่นหรือเปลี่ยนจอ ถ้าไอคอนเคลื่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan langsung setelah bangun dan ganti layar jika ikon bergeser."
          }
        }
      }
    },
    "Live checks after wake/display changes. Turn it on if icons drift after wake, monitor changes, or fast user switching. Leave it off for the calmer default Stability mode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live checks after wake/display changes. Turn it on if icons drift after wake, monitor changes, or fast user switching. Leave it off for the calmer default Stability mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒/显示器变化后实时检查。唤醒、换显示器或快速用户切换后图标会跑就打开。想更安静就关着，用默认的稳定模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喚醒／顯示器變化後即時檢查。喚醒、換顯示器或快速使用者切換後圖示會跑就打開。想更安靜就關著，用預設的穩定模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除/ディスプレイ変更後にライブ確認。ずれるならオン。落ち着いた安定モードならオフのままで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨우기/디스플레이 변경 후 실시간 확인. 깨우거나 모니터를 바꾸거나 빠른 사용자 전환 뒤 아이콘이 밀리면 켜세요. 더 차분한 기본 안정 모드를 쓰려면 꺼 두세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Prüfungen nach Aufwachen/Displaywechsel. Einschalten, wenn Symbole verrutschen. Aus lassen für den ruhigeren Stabilitätsmodus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôles en direct après réveil/écran. Activez si les icônes dérivent. Laissez désactivé pour le mode Stabilité, plus calme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobaciones en vivo tras despertar/pantalla. Actívalo si los iconos se desplazan. Déjalo apagado para el modo Estabilidad, más calmado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificações ao vivo após acordar/tela. Ative se os ícones saírem do lugar. Deixe desligado para o modo Estabilidade, mais calmo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlli live dopo risveglio/display. Attivalo se le icone si spostano. Lascialo spento per la Stabiltà, più calma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Livecontroles na ontwaken/scherm. Zet aan als pictogrammen schuiven. Laat uit voor de rustigere Stabiliteit-modus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm trực tiếp sau đánh thức/đổi màn. Bật nếu icon lệch lúc thức, đổi màn hay chuyển user nhanh. Để tắt thì dùng chế độ Ổn định êm hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสดหลังตื่น/เปลี่ยนจอ เปิดถ้าไอคอนเคลื่อนหลังตื่น เปลี่ยนจอ หรือสลับผู้ใช้เร็ว อยากสงบกว่านี้ให้ปิด ใช้โหมดเสถียรค่าเริ่มต้น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan langsung setelah bangun/ganti layar. Nyalakan jika ikon bergeser. Biarkan mati untuk mode Stabilitas yang lebih tenang."
          }
        }
      }
    },
    "Live checks enabled.": {
      "localizations": {
