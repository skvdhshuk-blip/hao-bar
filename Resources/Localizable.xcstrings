          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond af met een rechtencontrole en een opgeslagen herstelpunt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong phần cài bằng kiểm tra quyền và một điểm khôi phục bố cục."
