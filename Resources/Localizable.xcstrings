{
  "sourceLanguage": "en",
  "strings": {
    "\"For God has not given us a spirit of fear,": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"For God has not given us a spirit of fear,"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「因为神赐给我们，不是胆怯的心，"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「因為神賜給我們，不是膽怯的心，"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「神は、おくびょうの霊ではなく、"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「하나님이 우리에게 주신 것은 두려워하는 마음이 아니요"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Denn Gott hat uns nicht gegeben den Geist der Furcht,"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Car ce n’est pas un esprit de timidité que Dieu nous a donné,"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "« Porque no nos ha dado Dios espíritu de cobardía,"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "« Porque Deus não nos tem dado espírito de covardia,"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "« Poiché Dio non ci ha dato uno spirito di timidezza,"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Want God heeft ons niet gegeven een geest van vreesachtigheid,"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "« Vì Đức Chúa Trời chẳng ban cho chúng ta tâm thần nhút nhát,"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "« เพราะว่าพระเจ้าไม่ได้ทรงประทานจิตใจที่ขลาดกลัวให้เรา"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "« Sebab Allah memberikan kepada kita bukan roh ketakutan,"
          }
        }
      }
    },
    "\"The worker is worthy of his wages.\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"The worker is worthy of his wages.\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「工人得工价是应当的。」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「工人得工價是應當的。」"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「働く者が報酬を受けるのは当然である。」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「일꾼이 그 삯을 받는 것은 마땅하니라」"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Denn ein Arbeiter ist seines Lohnes wert.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« L’ouvrier mérite son salaire. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "« Digno es el obrero de su salario. »"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "« Digno é o trabalhador do seu salário. »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "« L’operaio è degno della sua mercede. »"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "„De arbeider is zijn loon waard.“"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "« Người làm công đáng được tiền lương. »"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "« คนงานสมควรจะได้รับค่าจ้างของตน »"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "« Seorang pekerja patut mendapat upahnya. »"
          }
        }
      }
    },
