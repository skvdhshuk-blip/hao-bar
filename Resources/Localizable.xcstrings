          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar pode inspecionar e organizar os itens da barra de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar può ispezionare e disporre gli elementi della barra dei menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kan menubalkitems inspecteren en ordenen."
          }
        },
        "vi": {
