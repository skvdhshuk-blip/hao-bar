          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Accessibilité pour que vous puissiez autoriser HaoBar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Accesibilidad para que puedas conceder permiso a HaoBar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Acessibilidade para você conceder permissão ao HaoBar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Accessibilità così puoi concedere il permesso a HaoBar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Toegankelijkheid zodat je HaoBar toestemming kunt geven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Trợ năng để bạn cấp quyền cho HaoBar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่าการเข้าถึง เพื่ออนุญาต HaoBar"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Aksesibilitas agar Anda dapat mengizinkan HaoBar."
          }
        }
