        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require Touch ID (or password on Macs without Touch ID) to reveal hidden menu bar icons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示隐藏的菜单栏图标需要 Touch ID（没有 Touch ID 的 Mac 则用密码）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示隱藏的選單列圖示需要 Touch ID（沒有 Touch ID 的 Mac 則用密碼）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示アイコンを出すにはTouch ID（非対応Macはパスワード）が必要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가려진 메뉴 막대 아이콘을 보려면 Touch ID가 필요합니다(없는 Mac은 암호)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID (oder Kennwort ohne Touch ID) zum Einblenden ausgeblendeter Symbole verlangen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger Touch ID (ou le mot de passe sans Touch ID) pour afficher les icônes masquées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir Touch ID (o contraseña sin Touch ID) para revelar iconos ocultos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir Touch ID (ou senha sem Touch ID) para revelar ícones ocultos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi Touch ID (o password senza Touch ID) per mostrare le icone nascoste"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID (of wachtwoord zonder Touch ID) vereisen om verborgen pictogrammen te tonen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần Touch ID (hoặc mật khẩu nếu máy không có) để hiện biểu tượng ẩn"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้ Touch ID (หรือรหัสผ่านถ้าไม่มี Touch ID) เพื่อเผยไอคอนที่ซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajibkan Touch ID (atau kata sandi jika tanpa Touch ID) untuk menampilkan ikon tersembunyi"
          }
        }
      }
    },
