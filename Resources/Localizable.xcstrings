    "Across SaneApps Mac apps, there have been over 100,000 downloads in the last 180 days. Fewer than 0.5% resulted in a purchase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across SaneApps Mac apps, there have been over 100,000 downloads in the last 180 days. Fewer than 0.5% resulted in a purchase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去 180 天里，SaneApps 的 Mac 应用合计下载超过 10 万次。真正购买的不到 0.5%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 180 天裡，SaneApps 的 Mac 應用程式合計下載超過 10 萬次。真正購買的不到 0.5%。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この180日でSaneAppsのMacアプリは合わせて10万回以上ダウンロードされました。購入に至ったのは0.5%未満です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 180일 동안 SaneApps Mac 앱 다운로드는 10만 회가 넘습니다. 구매로 이어진 경우는 0.5% 미만입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 180 Tagen gab es über 100.000 Downloads der SaneApps-Mac-Apps. Weniger als 0,5 % führten zu einem Kauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les 180 derniers jours, les apps Mac SaneApps ont dépassé 100 000 téléchargements. Moins de 0,5 % ont abouti à un achat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los últimos 180 días, las apps Mac de SaneApps superaron las 100.000 descargas. Menos del 0,5% acabó en una compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos últimos 180 dias, os apps Mac da SaneApps passaram de 100 mil downloads. Menos de 0,5% viraram compra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negli ultimi 180 giorni le app Mac di SaneApps hanno superato 100.000 download. Meno dello 0,5% è diventato un acquisto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de afgelopen 180 dagen waren er meer dan 100.000 downloads van SaneApps-Mac-apps. Minder dan 0,5% leidde tot een aankoop."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong 180 ngày qua, các app Mac của SaneApps đã có hơn 100.000 lượt tải. Chưa tới 0,5% là mua thật."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน 180 วันที่ผ่านมา แอป Mac ของ SaneApps ดาวน์โหลดรวมเกิน 100,000 ครั้ง มีไม่ถึง 0.5% ที่กลายเป็นการซื้อ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam 180 hari terakhir, app Mac SaneApps diunduh lebih dari 100.000 kali. Kurang dari 0,5% berujung pembelian."
          }
        }
      }
    },
