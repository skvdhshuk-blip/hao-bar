            "value": "Tampilkan ikon baterai dan daya secara otomatis saat baterai lemah."
          }
        }
      }
    },
    "Reveal chosen menu bar icons automatically when selected apps launch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveal chosen menu bar icons automatically when selected apps launch"
          }
        },
        "zh-Hans": {
