          }
        }
      }
    },
    "HaoBar can run Arrange Now to refresh older menu bar anchor positions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar can run Arrange Now to refresh older menu bar anchor positions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 可以运行「立即整理」来刷新较旧的菜单栏锚点位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 可以執行「立即整理」來重新整理較舊的選單列錨點位置。"
          }
        },
        "ja": {
