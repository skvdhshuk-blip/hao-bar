    "HaoBar needs Accessibility permission before Browse Icons, Arrange Now, and diagnostics can inspect menu bar items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar needs Accessibility permission before Browse Icons, Arrange Now, and diagnostics can inspect menu bar items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要先授予辅助功能权限，「浏览图标」「立即整理」和诊断才能查看菜单栏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要先授予輔助使用權限，「瀏覽圖示」「立即整理」和診斷才能查看選單列項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アイコンを表示」「今すぐ整列」、診断が項目を調べるには、先にアクセシビリティ許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘아이콘 둘러보기’, ‘지금 정렬’, 진단이 메뉴 막대 항목을 보려면 먼저 손쉬운 사용 권한이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für „Symbole durchsuchen“, „Jetzt anordnen“ und Diagnose braucht HaoBar zuerst Bedienungshilfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar a besoin d’Accessibilité avant que Parcourir les icônes, Organiser maintenant et les diagnostics puissent inspecter les éléments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar necesita Accesibilidad antes de que Explorar iconos, Organizar ahora y el diagnóstico puedan inspeccionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar precisa de Acessibilidade antes que Explorar ícones, Organizar agora e o diagnóstico possam inspecionar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar richiede Accessibilità prima che Sfoglia icone, Disponi ora e la diagnostica possano ispezionare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar heeft Toegankelijkheid nodig voordat Pictogrammen bekijken, Nu ordenen en diagnostiek items kunnen inspecteren."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền Trợ năng trước khi Duyệt biểu tượng, Sắp xếp ngay và chẩn đoán xem được mục thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีสิทธิ์การเข้าถึงก่อน เรียกดูไอคอน จัดเรียงทันที และการวินิจฉัยจึงจะตรวจรายการแถบเมนูได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar memerlukan izin Aksesibilitas sebelum Jelajahi ikon, Atur sekarang, dan diagnostik dapat memeriksa item."
          }
        }
      }
    },
