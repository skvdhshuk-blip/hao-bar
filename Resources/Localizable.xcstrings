        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงไอคอนที่เลือกอัตโนมัติเมื่อเปิดแอปที่กำหนด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan ikon yang dipilih secara otomatis saat app terpilih dibuka."
          }
        }
      }
    },
    "Reveal hidden icons only during selected days and time windows": {
      "localizations": {
        "en": {
