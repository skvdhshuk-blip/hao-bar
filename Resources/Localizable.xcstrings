          }
        }
      }
    },
    "Run your own script to decide when hidden icons should show or hide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run your own script to decide when hidden icons should show or hide"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的脚本决定何时显示或隐藏图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你自己的腳本決定何時顯示或隱藏圖示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のスクリプトで、非表示アイコンの表示タイミングを決めます。"
