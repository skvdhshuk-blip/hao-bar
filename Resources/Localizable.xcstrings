    "Open a row-based strip under the menu bar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a row-based strip under the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏下方打开一条分行的条带。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列下方打開一條分列的條帶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの下に行ベースの帯を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아래에 열 단위 띠를 엽니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen reihenbasierten Streifen unter der Menüleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une bande en rangées sous la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una franja por filas bajo la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma faixa em linhas sob a barra de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una striscia a righe sotto la barra dei menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een rijstrook onder de menubalk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một dải theo hàng dưới thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแถบแบบแถวใต้แถบเมนู"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka pita berbasis baris di bawah bilah menu."
          }
        }
      }
    },
    "Open a row-based strip under the menu bar. Basic includes browsing and clicking there. Pro adds moving icons and Always Hidden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a row-based strip under the menu bar. Basic includes browsing and clicking there. Pro adds moving icons and Always Hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏下方打开分行条带。基础版可浏览和点击。Pro 可移动图标并使用始终隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列下方打開分列條帶。基礎版可瀏覽和點按。Pro 可移動圖示並使用一律隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に行ベースの帯を開きます。基本は閲覧とクリック。Proは移動と常に非表示も。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 열 단위 띠를 엽니다. 기본은 둘러보고 클릭. Pro는 아이콘 이동과 항상 숨김까지."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet einen Streifen unter der Menüleiste. Basis: durchsuchen und klicken. Pro: Symbole verschieben und Immer ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une bande sous la barre. La version de base permet de parcourir et cliquer. Pro ajoute le déplacement et Toujours masqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una franja bajo la barra. Lo básico incluye explorar y hacer clic. Pro añade mover iconos y Siempre oculto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre uma faixa sob a barra. O básico inclui explorar e clicar. O Pro adiciona mover ícones e Sempre oculto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una striscia sotto la barra. Il base consente di sfogliare e fare clic. Pro aggiunge lo spostamento e Sempre nascosto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een strook onder de menubalk. Basis: bekijken en klikken. Pro: pictogrammen verplaatsen en Altijd verborgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở dải theo hàng dưới thanh menu. Bản cơ bản duyệt và bấm. Pro thêm chuyển icon và Luôn ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแถบแบบแถวใต้แถบเมนู รุ่นพื้นฐานเรียกดูและคลิกได้ Pro เพิ่มการย้ายไอคอนกับซ่อนตลอด"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka pita di bawah bilah menu. Dasar: jelajah dan klik. Pro menambah pemindahan ikon dan Selalu tersembunyi."
          }
        }
      }
    },
    "Open Accessibility settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开辅助功能设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開輔助使用設定"
          }
        }
      }
    },
    "Open Accessibility settings and enable %@. If that switch is already on, it belongs to another HaoBar copy — turn this one off and on, then click Try Again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility settings and enable %@. If that switch is already on, it belongs to another HaoBar copy — turn this one off and on, then click Try Again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开辅助功能设置并启用 %@。如果开关已经是开的，那是另一份 HaoBar — 先关掉再打开这一份，然后点「再试一次」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開輔助功能設定並啟用 %@。如果開關已經是開的，那是另一份 HaoBar — 先關掉再開啟這一份，然後點「再試一次」。"
          }
        }
      }
    },
