    "Set the same start/end time for all-day schedule.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the same start/end time for all-day schedule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天日程请把开始和结束设为同一时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全天行程請把開始和結束設為同一時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終日スケジュールは開始と終了を同じ時刻にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 종일 일정은 시작과 끝을 같은 시각으로 두세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ganztägige Zeitpläne Start- und Endzeit gleich setzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une journée entière, mettez la même heure de début et de fin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para el día completo, pon la misma hora de inicio y fin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o dia inteiro, use o mesmo horário de início e fim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tutto il giorno, imposta la stessa ora di inizio e fine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet voor een hele dag dezelfde begin- en eindtijd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch cả ngày thì đặt giờ bắt đầu và kết thúc giống nhau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตารางทั้งวันให้ตั้งเวลาเริ่มกับสิ้นสุดเป็นเวลาเดียวกัน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk jadwal seharian, samakan waktu mulai dan selesai."
          }
        }
      }
    },
