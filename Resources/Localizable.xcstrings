    "Closes this check. Open Settings > Health later if you still need a restore point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes this check. Open Settings > Health later if you still need a restore point."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭这次检查。以后若还需要还原点，打开设置 > 健康状况即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉這次檢查。以後若還需要還原點，打開設定 > 健康狀態即可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この確認を閉じます。復元ポイントが必要なら、あとで設定 > 状態を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 확인을 닫습니다. 복원 지점이 더 필요하면 나중에 설정 > 상태에서 여세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt diese Prüfung. Öffne später Einstellungen > Zustand, wenn du noch einen Wiederherstellungspunkt brauchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme cette vérification. Ouvrez Réglages > Santé plus tard si vous avez encore besoin d’un point de restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra esta comprobación. Abre Ajustes > Salud después si aún necesitas un punto de restauración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha esta verificação. Abra Ajustes > Integridade depois se ainda precisar de um ponto de restauração."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiude questo controllo. Apri Impostazioni > Integrità più tardi se ti serve ancora un punto di ripristino."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit deze controle. Open later Instellingen > Gezondheid als je nog een herstelpunt nodig hebt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng lần kiểm này. Sau nếu còn cần điểm khôi phục, mở Cài đặt > Tình trạng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการตรวจนี้ ถ้ายังต้องใช้จุดคืนค่า ให้เปิดการตั้งค่า > สุขภาพภายหลัง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutup pemeriksaan ini. Buka Pengaturan > Kesehatan nanti jika masih perlu titik pemulihan."
          }
        }
      }
    },
