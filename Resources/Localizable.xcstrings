        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar cannot save this layout yet because macOS has not provided trustworthy menu bar positions. Run Arrange Now, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 还不能保存此布局，因为 macOS 尚未提供可信的菜单栏位置。请先点「立即整理」，然后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 還不能儲存此佈局，因為 macOS 尚未提供可信的選單列位置。請先點「立即整理」，然後再試。"
          }
        }
      }
    },
    "HaoBar couldn't turn this on safely. Open Health and repair menu bar detection, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar couldn't turn this on safely. Open Health and repair menu bar detection, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 没法安全地打开这项。请打开健康状况、修好菜单栏检测后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 沒辦法安全地打開這項。請打開健康狀態、修好選單列偵測後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全にオンにできませんでした。状態を開いてメニューバー検出を修復してから再試行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 켤 수 없었습니다. 상태를 열어 메뉴 막대 감지를 고친 뒤 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar konnte das nicht sicher einschalten. Öffne Zustand, repariere die Menüleisten-Erkennung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar n’a pas pu l’activer en toute sécurité. Ouvrez Santé, réparez la détection, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar no pudo activarlo con seguridad. Abre Salud, repara la detección y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar não pôde ativar isso com segurança. Abra Integridade, repare a detecção e tente de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar non è riuscito ad attivarlo in sicurezza. Apri Integrità, ripara il rilevamento e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kon dit niet veilig aanzetten. Open Gezondheid, herstel de detectie en probeer opnieuw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar không bật an toàn được. Mở Tình trạng, sửa nhận diện thanh menu, rồi thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar เปิดสิ่งนี้แบบปลอดภัยไม่ได้ เปิดสุขภาพแล้วซ่อมการตรวจจับแถบเมนูก่อน แล้วลองใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar tidak bisa mengaktifkannya dengan aman. Buka Kesehatan, perbaiki deteksi, lalu coba lagi."
          }
        }
      }
    },
    "HaoBar couldn’t move that icon in the sandbox. ⌘-drag it in the menu bar instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar couldn’t move that icon in the sandbox. ⌘-drag it in the menu bar instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受沙盒限制，HaoBar 移不了那个图标。请在菜单栏里按住 ⌘ 拖动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受沙盒限制，HaoBar 移不了那個圖示。請在選單列裡按住 ⌘ 拖曳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックス内ではそのアイコンを動かせません。メニューバーで⌘ドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샌드박스에서는 그 아이콘을 옮길 수 없습니다. 메뉴 막대에서 ⌘ 드래그하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar konnte das Symbol in der Sandbox nicht verschieben. Ziehe es stattdessen mit ⌘ in der Menüleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar n’a pas pu déplacer cette icône dans le bac à sable. Faites-la glisser avec ⌘ dans la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar no pudo mover ese icono en el sandbox. Arrástralo con ⌘ en la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar não pôde mover esse ícone no sandbox. Arraste-o com ⌘ na barra de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar non è riuscito a spostare quell’icona nella sandbox. Trascinala con ⌘ nella barra dei menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kon dat pictogram in de sandbox niet verplaatsen. Sleep het met ⌘ in de menubalk."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar không chuyển được biểu tượng đó trong sandbox. Hãy giữ ⌘ kéo trên thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ย้ายไอคอนนั้นในแซนด์บ็อกซ์ไม่ได้ ให้กด ⌘ ค้างแล้วลากบนแถบเมนูแทน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar tidak bisa memindahkan ikon itu di sandbox. Seret dengan ⌘ di bilah menu."
          }
        }
      }
    },
    "HaoBar does not have enough menu bar anchor data. Run Arrange Now to rebuild it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar does not have enough menu bar anchor data. Run Arrange Now to rebuild it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 的菜单栏锚点数据不够。请运行「立即整理」重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 的選單列錨點資料不夠。請執行「立即整理」重建。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアンカーデータが足りません。「今すぐ整列」で作り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 앵커 데이터가 부족합니다. ‘지금 정렬’로 다시 만드세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar hat zu wenig Ankerdaten. Führe „Jetzt anordnen“ aus, um sie neu aufzubauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar n’a pas assez de données d’ancrage. Lancez Organiser maintenant pour les reconstruire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar no tiene suficientes anclas. Ejecuta Organizar ahora para reconstruirlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar não tem âncoras suficientes. Execute Organizar agora para reconstruí-las."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar non ha abbastanza ancore. Esegui Disponi ora per ricostruirle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar heeft te weinig ankergegevens. Voer Nu ordenen uit om ze opnieuw op te bouwen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar chưa đủ dữ liệu mốc neo. Chạy Sắp xếp ngay để dựng lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar มีข้อมูลจุดยึดแถบเมนูไม่พอ รันจัดเรียงทันทีเพื่อสร้างใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar kekurangan data jangkar. Jalankan Atur sekarang untuk membangunnya ulang."
          }
        }
      }
    },
    "HaoBar has Accessibility permission and can inspect, reveal, and arrange menu bar items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar has Accessibility permission and can inspect, reveal, and arrange menu bar items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 已有辅助功能权限，可以查看、显示并整理菜单栏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar 已有輔助使用權限，可以查看、顯示並整理選單列項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの許可があり、メニューバー項目を調べ、表示し、整列できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 있어 메뉴 막대 항목을 살펴보고, 표시하고, 정렬할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar hat Bedienungshilfen und kann Menüleistenobjekte prüfen, einblenden und anordnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar a l’accès Accessibilité et peut inspecter, afficher et ranger les éléments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar tiene Accesibilidad y puede inspeccionar, revelar y organizar elementos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HaoBar tem Acessibilidade e pode inspecionar, revelar e organizar itens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar ha Accessibilità e può ispezionare, mostrare e disporre gli elementi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar heeft Toegankelijkheid en kan items inspecteren, tonen en ordenen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar đã có quyền Trợ năng, xem/hiện/sắp xếp được mục thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar มีสิทธิ์การเข้าถึงแล้ว ตรวจ แสดง และจัดเรียงรายการแถบเมนูได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HaoBar punya izin Aksesibilitas dan dapat memeriksa, menampilkan, serta merapikan item."
          }
        }
      }
    },
    "HaoBar has current menu bar anchor positions from the live system.": {
