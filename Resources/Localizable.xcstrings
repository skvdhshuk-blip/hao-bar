    "Opens macOS System Settings directly to Privacy & Security > Accessibility so you can grant or repair HaoBar's permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens macOS System Settings directly to Privacy & Security > Accessibility so you can grant or repair HaoBar's permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接打开 macOS 系统设置的隐私与安全性 > 辅助功能，以便授予或修复 HaoBar 的权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接打開 macOS 系統設定的隱私權與安全性 > 輔助使用，以便授予或修復 HaoBar 的權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定のプライバシーとセキュリティ > アクセシビリティを直接開き、HaoBarの許可を出したり直したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정의 개인 정보 보호 및 보안 > 손쉬운 사용으로 바로 가서 HaoBar 권한을 주거나 고칠 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Systemeinstellungen direkt bei Datenschutz & Sicherheit > Bedienungshilfen, um HaoBars Erlaubnis zu erteilen oder zu reparieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Réglages Système sur Confidentialité et sécurité > Accessibilité pour accorder ou réparer l’autorisation de HaoBar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema en Privacidad y seguridad > Accesibilidad para conceder o reparar el permiso de HaoBar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes do Sistema em Privacidade e segurança > Acessibilidade para conceder ou reparar a permissão do HaoBar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Impostazioni di Sistema su Privacy e sicurezza > Accessibilità per concedere o riparare il permesso di HaoBar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Systeeminstellingen bij Privacy en beveiliging > Toegankelijkheid om HaoBars toestemming te geven of te herstellen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thẳng Cài đặt Hệ thống tới Quyền riêng tư và Bảo mật > Trợ năng để cấp hoặc sửa quyền HaoBar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตั้งค่าระบบไปที่ความเป็นส่วนตัวและความปลอดภัย > การเข้าถึง เพื่อให้หรือซ่อมสิทธิ์ HaoBar"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Pengaturan Sistem ke Privasi & Keamanan > Aksesibilitas agar Anda dapat memberi atau memperbaiki izin HaoBar."
          }
        }
      }
    },
    "Opens macOS System Settings so you can manage which icons are allowed in the menu bar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens macOS System Settings so you can manage which icons are allowed in the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 macOS 系统设置，以便管理哪些图标可以出现在菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 macOS 系統設定，以便管理哪些圖示可以出現在選單列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開き、メニューバーに出せるアイコンを管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정을 열어 메뉴 막대에 허용할 아이콘을 관리할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Systemeinstellungen, damit du festlegen kannst, welche Symbole in der Menüleiste erlaubt sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Réglages Système pour gérer quelles icônes sont autorisées dans la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes del Sistema para gestionar qué iconos se permiten en la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes do Sistema para gerenciar quais ícones podem aparecer na barra de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Impostazioni di Sistema per gestire quali icone sono ammesse nella barra dei menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Systeeminstellingen zodat je kunt beheren welke pictogrammen in de menubalk mogen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt Hệ thống để chọn icon nào được phép trên thanh menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตั้งค่าระบบ เพื่อจัดการว่าไอคอนใดอยู่ในแถบเมนูได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Pengaturan Sistem agar Anda dapat mengatur ikon mana yang diizinkan di bilah menu."
          }
        }
      }
