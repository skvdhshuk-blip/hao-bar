    "It's only a few screens and you'll be\nconfused if you rush through.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's only a few screens and you'll be\nconfused if you rush through."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一共就几屏，赶着点完\n反而会看不懂。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一共就幾屏，趕著點完\n反而會看不懂。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数画面だけ。急いで飛ばすと\nかえって迷います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 화면뿐입니다. 급하게 넘기면\n더 헷갈려요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein paar Bildschirme – wenn du hetzt,\nwirst du durcheinanderkommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques écrans seulement ;\nsi vous foncez, vous serez perdu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son solo unas pantallas;\nsi corres, te liarás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São só algumas telas;\nse correr, vai ficar perdido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono poche schermate;\nse hai fretta ti confondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maar een paar schermen;\nals je racet, raak je in de war."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vài màn. Vội vàng\nlà sẽ rối."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแค่ไม่กี่หน้า รีบคลิกผ่าน\nจะยิ่งงง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma beberapa layar;\nkalau terburu-buru malah bingung."
          }
        }
      }
    },
