    "3. Right-click an icon for more actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Right-click an icon for more actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 右键点击图标可查看更多操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 按住 Control 點一下圖示可查看更多操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. アイコンを右クリックしてほかの操作を表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 아이콘을 클릭하면서 Control을 누르면 추가 동작을 볼 수 있습니다."
          }
        },
