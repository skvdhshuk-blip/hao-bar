    "Keep icons visible on external displays where menu bar space is less constrained.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep icons visible on external displays where menu bar space is less constrained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外接显示器菜单栏更宽裕，可让图标保持可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外接顯示器選單列較寬裕，可讓圖示保持可見。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースに余裕のある外部ディスプレイではアイコンを表示したまま。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 덜 빠듯한 외장 디스플레이에서는 아이콘을 계속 보여 줍니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf externen Displays mit mehr Platz Symbole sichtbar lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les icônes visibles sur les écrans externes, où la barre des menus est plus large."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén los iconos visibles en pantallas externas, donde hay más espacio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os ícones visíveis em telas externas, onde há mais espaço."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia visibili le icone sui display esterni, dove c’è più spazio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd pictogrammen zichtbaar op externe schermen, waar meer ruimte is."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ biểu tượng hiện trên màn hình ngoài, nơi thanh menu rộng hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ไอคอนยังเห็นบนจอภายนอก ที่แถบเมนูไม่คับแคบเท่า"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan ikon terlihat di layar eksternal, di mana ruangnya lebih longgar."
          }
        }
      }
    },
    "Keep only the explicitly visible items shown; move other detected menu bar items to Hidden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep only the explicitly visible items shown; move other detected menu bar items to Hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留明确设为可见的项目，把其余检测到的菜单栏项目移到隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留明確設為可見的項目，把其餘偵測到的選單列項目移到隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明示的に表示中の項目だけ残し、ほかに検出した項目は非表示へ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명시적으로 표시된 항목만 남기고, 나머지 감지된 항목은 숨김으로 옮깁니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausdrücklich sichtbare Objekte behalten; alle anderen erkannten in Ausgeblendet legen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne garder que les éléments explicitement visibles ; déplacer les autres vers Masqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja solo los explícitamente visibles; mueve el resto a Oculto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha só os explicitamente visíveis; mova os demais para Oculto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni solo quelli esplicitamente visibili; sposta gli altri in Nascosto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd alleen expliciet zichtbare items; verplaats de rest naar Verborgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giữ mục được đặt là hiện; chuyển các mục phát hiện khác sang Ẩn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือเฉพาะรายการที่ตั้งให้แสดงชัดเจน รายการอื่นที่ตรวจพบให้ย้ายไปซ่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pertahankan item yang terlihat secara eksplisit; pindahkan yang terdeteksi lain ke Tersembunyi."
          }
        }
      }
    },
