    "Scroll up shows icons, scroll down hides icons.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll up shows icons, scroll down hides icons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上滚动显示图标，向下滚动隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上捲動顯示圖示，向下捲動隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上スクロールで表示、下スクロールで隠す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위로 스크롤하면 보이고, 아래로 스크롤하면 가려집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach oben scrollen zeigt Symbole, nach unten blendet sie aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défiler vers le haut affiche, vers le bas masque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza arriba para mostrar, abajo para ocultar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role para cima para mostrar, para baixo para ocultar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su per mostrare, giù per nascondere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog scrollen toont, omlaag verbergt."
          }
        },
        "vi": {
          "stringUnit": {
