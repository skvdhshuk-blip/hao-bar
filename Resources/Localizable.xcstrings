            "state": "translated",
            "value": "Dank je dat je SaneApps mogelijk maakt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã giúp SaneApps tồn tại."
          }
