    "Add a thin border around the menu bar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a thin border around the menu bar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给菜单栏加上细边框"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫選單列加上細邊框"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの周りに細い枠を付ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 둘레에 얇은 테두리를 넣습니다"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen dünnen Rahmen um die Menüleiste legen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une fine bordure autour de la barre des menus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un borde fino alrededor de la barra de menús"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar uma borda fina ao redor da barra de menus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un bordo sottile intorno alla barra dei menu"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dunne rand om de menubalk zetten"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm viền mỏng quanh thanh menu"
          }
        },
        "th": {
