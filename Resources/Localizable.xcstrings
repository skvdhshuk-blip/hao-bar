    "Stability repairs only at startup or when you click Arrange Now. This is the calm default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stability repairs only at startup or when you click Arrange Now. This is the calm default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定模式只在启动或你点「立即整理」时修复。这是安静的默认选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "穩定模式只在啟動或你點「立即整理」時修復。這是安靜的預設選項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定モードは起動時か「今すぐ整列」のときだけ修復。落ち着いたデフォルトです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안정 모드는 시작할 때나 ‘지금 정렬’을 눌렀을 때만 고칩니다. 차분한 기본값입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilität repariert nur beim Start oder nach „Jetzt anordnen“. Das ist die ruhige Voreinstellung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilité ne répare qu’au démarrage ou via Organiser maintenant. C’est le réglage calme par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabilidad solo repara al arrancar o al pulsar Organizar ahora. Es el valor calmado predeterminado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabilidade só repara na abertura ou ao clicar em Organizar agora. É o padrão mais calmo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilità ripara solo all’avvio o con Disponi ora. È l’impostazione calma predefinita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabiliteit herstelt alleen bij het opstarten of via Nu ordenen. Dat is de kalme standaard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổn định chỉ sửa lúc mở app hoặc khi bấm Sắp xếp ngay. Đây là mặc định êm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดเสถียรซ่อมเฉพาะตอนเปิดหรือเมื่อคลิกจัดเรียงทันที เป็นค่าเริ่มต้นที่สงบ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilitas hanya memperbaiki saat mulai atau saat Anda klik Atur sekarang. Ini default yang tenang."
          }
        }
      }
    },
