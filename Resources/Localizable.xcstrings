            "state": "translated",
            "value": "Die Menüleiste wird eng."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre des menus commence à être bondée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de menús se está llenando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de menus está ficando lotada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra dei menu si sta riempiendo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De menubalk raakt vol."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh menu đang chật dần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบเมนูเริ่มแน่น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah menu mulai penuh."
          }
        }
      }
    },
    "The saved known-good layout HaoBar can return to if icons drift after restart, wake, or display changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved known-good layout HaoBar can return to if icons drift after restart, wake, or display changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的已知正常布局。重启、唤醒或换显示器后图标跑偏时，HaoBar 可以回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的已知正常佈局。重新開機、喚醒或換顯示器後圖示跑掉時，HaoBar 可以回到這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した正常レイアウト。再起動、スリープ解除、ディスプレイ変更でずれたらここに戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장해 둔 정상 레이아웃입니다. 재시동, 깨우기, 디스플레이 변경 뒤 아이콘이 밀리면 HaoBar가 여기로 돌아갑니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte gute Layout, zu dem HaoBar zurückkehren kann, wenn Symbole nach Neustart, Aufwachen oder Displaywechsel verrutschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposition saine enregistrée, vers laquelle HaoBar peut revenir si les icônes dérivent après redémarrage, réveil ou changement d’écran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposición correcta guardada a la que HaoBar puede volver si los iconos se desplazan tras reiniciar, despertar o cambiar de pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O layout bom salvo para o HaoBar voltar se os ícones saírem do lugar após reiniciar, acordar ou mudar de tela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il layout valido salvato a cui HaoBar può tornare se le icone si spostano dopo riavvio, risveglio o cambio display."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde goede lay-out waar HaoBar naartoe kan als pictogrammen na herstart, ontwaken of schermwissel schuiven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục ổn đã lưu. HaoBar có thể quay lại nếu icon lệch sau khởi động lại, đánh thức hoặc đổi màn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์ที่ดีที่บันทึกไว้ HaoBar กลับมาได้ถ้าไอคอนเคลื่อนหลังรีสตาร์ท ตื่น หรือเปลี่ยนจอ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak baik tersimpan yang dapat dikembalikan HaoBar jika ikon bergeser setelah mulai ulang, bangun, atau ganti layar."
          }
        }
      }
    },
    "This does not lock SaneBar. The app remains free.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not lock SaneBar. The app remains free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不会锁定 SaneBar。应用仍然免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不會鎖定 SaneBar。App 仍然免費。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これでSaneBarがロックされることはありません。アプリは無料のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것으로 SaneBar가 잠기지는 않습니다. 앱은 계속 무료입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sperrt SaneBar nicht. Die App bleibt kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne verrouille pas SaneBar. L’app reste gratuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no bloquea SaneBar. La app sigue siendo gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não bloqueia o SaneBar. O app continua grátis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non blocca SaneBar. L’app resta gratuita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit vergrendelt SaneBar niet. De app blijft gratis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này không khóa SaneBar. App vẫn miễn phí."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันนี้ไม่ได้ล็อก SaneBar แอปยังใช้ฟรี"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak mengunci SaneBar. App tetap gratis."
          }
        }
      }
    },
    "This import enables script-based control. Only import files you trust.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This import enables script-based control. Only import files you trust."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次导入会启用基于脚本的控制。请只导入你信任的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此次輸入會啟用以腳本控制。請只輸入你信任的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この読み込みでスクリプト制御が有効になります。信頼できるファイルだけ読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가져오기는 스크립트 제어를 켭니다. 신뢰하는 파일만 가져오세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Import aktiviert die Steuerung per Skript. Importiere nur Dateien, denen du vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet import active le contrôle par script. N’importez que des fichiers de confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta importación activa el control por script. Importa solo archivos de confianza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta importação ativa o controle por script. Importe só arquivos em que você confia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa importazione abilita il controllo da script. Importa solo file di cui ti fidi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze import zet scriptbesturing aan. Importeer alleen bestanden die je vertrouwt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần nhập này bật điều khiển bằng script. Chỉ nhập tệp bạn tin."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้านี้จะเปิดการควบคุมด้วยสคริปต์ นำเข้าเฉพาะไฟล์ที่ไว้ใจ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor ini mengaktifkan kontrol berbasis skrip. Hanya impor file yang Anda percaya."
          }
        }
      }
    },
    "This import will keep the shown items visible and hide newly detected menu bar items by default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This import will keep the shown items visible and hide newly detected menu bar items by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次导入会保持已显示的项目可见，并默认隐藏新检测到的菜单栏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此次輸入會保持已顯示的項目可見，並預設隱藏新偵測到的選單列項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この読み込みでは表示中の項目はそのまま、新しく検出した項目はデフォルトで隠します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가져오기는 보이는 항목은 그대로 두고, 새로 감지된 메뉴 막대 항목은 기본적으로 가립니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Import lässt gezeigte Objekte sichtbar und blendet neu erkannte Menüleistenobjekte standardmäßig aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet import garde les éléments affichés et masque par défaut les nouveaux éléments détectés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta importación deja visibles los mostrados y oculta por defecto los recién detectados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta importação mantém os exibidos visíveis e oculta por padrão os recém-detectados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa importazione lascia visibili quelli mostrati e nasconde per impostazione predefinita i nuovi rilevati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze import houdt getoonde items zichtbaar en verbergt standaard nieuw gedetecteerde items."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần nhập này giữ mục đang hiện, và mặc định ẩn mục thanh menu mới phát hiện."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้านี้จะคงรายการที่แสดงไว้ และซ่อนรายการแถบเมนูที่เพิ่งตรวจพบเป็นค่าเริ่มต้น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor ini menjaga item yang tampil tetap terlihat dan menyembunyikan item baru terdeteksi secara default."
          }
        }
      }
    },
    "This will reset all settings to their defaults. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will reset all settings to their defaults. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有设置会恢复默认，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有設定會回復預設，且無法還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定がデフォルトに戻り、元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정이 기본값으로 돌아가며 되돌릴 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen werden auf die Standardwerte zurückgesetzt. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages reviendront à leurs valeurs par défaut. Action irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecerán todos los ajustes. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os ajustes voltarão ao padrão. Isso não pode ser desfeito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le impostazioni torneranno ai valori predefiniti. Non si può annullare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle instellingen gaan terug naar de standaard. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi cài đặt sẽ về mặc định và không hoàn tác được."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าทั้งหมดจะกลับเป็นค่าเริ่มต้น และย้อนไม่ได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pengaturan akan kembali ke bawaan. Ini tidak dapat dibatalkan."
          }
        }
      }
    },
