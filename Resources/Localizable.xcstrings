    "Open Accessibility settings and grant HaoBar before using Browse Icons or Arrange Now.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility settings and grant HaoBar before using Browse Icons or Arrange Now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「浏览图标」或「立即整理」前，请打开辅助功能设置并授予 HaoBar。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「瀏覽圖示」或「立即整理」前，請打開輔助使用設定並授予 HaoBar。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アイコンを表示」や「今すぐ整列」の前に、アクセシビリティ設定を開いてHaoBarを許可。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘아이콘 둘러보기’나 ‘지금 정렬’을 쓰기 전에 손쉬운 사용 설정을 열고 HaoBar를 허용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Bedienungshilfen und erlaube HaoBar, bevor du „Symbole durchsuchen“ oder „Jetzt anordnen“ nutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Accessibilité et autorisez HaoBar avant d’utiliser Parcourir les icônes ou Organiser maintenant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Accesibilidad y concede HaoBar antes de Explorar iconos u Organizar ahora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Acessibilidade e conceda o HaoBar antes de Explorar ícones ou Organizar agora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Accessibilità e concedi HaoBar prima di Sfoglia icone o Disponi ora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Toegankelijkheid en geef HaoBar toestemming vóór Pictogrammen bekijken of Nu ordenen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Trợ năng và cấp quyền HaoBar trước khi dùng Duyệt biểu tượng hoặc Sắp xếp ngay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่าการเข้าถึงแล้วอนุญาต HaoBar ก่อนใช้เรียกดูไอคอนหรือจัดเรียงทันที"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Aksesibilitas dan izinkan HaoBar sebelum Jelajahi ikon atau Atur sekarang."
          }
        }
      }
    },
